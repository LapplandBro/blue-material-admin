{% extends 'layout.twig' %}
{% block extra_head %}
<link href="{{ asset_base }}themes/blue_v2/css/admin_hub.css?v={{ css_ver }}" rel="stylesheet">
{% endblock %}
{% block topbar_title %}
<span class="h5 mb-0">Панель управления</span>
{% endblock %}
{% block content %}
<div class="admin-hub" id="cpanel">
  <div class="admin-hub-head">
    <p class="admin-hub-kicker">Админка</p>
    <h1>Панель управления</h1>
    <p>Модерация, серверы и настройки</p>
  </div>

  {% if access_bans or access_recidivism or access_parsec %}
  <section class="admin-hub-section">
    <p class="admin-hub-kicker">Модерация</p>
    <div class="admin-hub-grid">
      {% if access_bans %}
      <a class="admin-hub-tile" href="index.php?p=admin&amp;c=bans">
        <span class="admin-hub-tile-head">
          <span class="admin-hub-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.4 19.2 6.8v6.4c0 4.4-3.1 7.6-7.2 8.6-4.1-1-7.2-4.2-7.2-8.6V6.8L12 3.4z"/><path d="M8.4 12h7.2M12 8.4v7.2"/></svg>
          </span>
          <span class="admin-hub-count">{{ total_bans }}</span>
        </span>
        <span class="admin-hub-tile-title">Баны</span>
        <span class="admin-hub-tile-desc">Выдать, снять, протесты и заявки</span>
        <span class="admin-hub-tile-meta">протесты {{ total_protests }} · заявки {{ total_submissions }} · демо {{ demosize }}</span>
      </a>
      <div class="admin-hub-tile admin-hub-tile--with-extra">
        <a class="admin-hub-tile-main" href="index.php?p=admin&amp;c=comms">
          <span class="admin-hub-tile-head">
            <span class="admin-hub-mark" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.6v8.6a3.2 3.2 0 0 1-3.2 3.2A3.2 3.2 0 0 1 5.6 12V11"/><path d="M5.6 11a6.4 6.4 0 0 0 12.8 0"/><path d="M12 20.4v-2.6"/><path d="M4.6 4.6l14.8 14.8"/></svg>
            </span>
          </span>
          <span class="admin-hub-tile-title">Муты и гаги</span>
          <span class="admin-hub-tile-desc">Блок чата и микрофона</span>
        </a>
        <a class="admin-hub-tile-extra" href="index.php?p=commslist">Список</a>
      </div>
      {% endif %}
      {% if access_recidivism %}
      <a class="admin-hub-tile" href="index.php?p=admin&amp;c=recidivism">
        <span class="admin-hub-tile-head">
          <span class="admin-hub-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M5 19V9.5"/><path d="M10 19V5.5"/><path d="M15 19v-7"/><path d="M20 19V8"/></svg>
          </span>
        </span>
        <span class="admin-hub-tile-title">Нарушения</span>
        <span class="admin-hub-tile-desc">Очки за баны, гаги и муты</span>
      </a>
      {% endif %}
      {% if access_parsec %}
      <a class="admin-hub-tile" href="index.php?p=admin&amp;c=parsec">
        <span class="admin-hub-tile-head">
          <span class="admin-hub-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="7.2" cy="8" r="2.4"/><circle cx="16.8" cy="8" r="2.4"/><path d="M4.2 18.2c.5-2.8 2.1-4.3 3-4.3s2.5 1.5 3 4.3"/><path d="M13.8 18.2c.5-2.8 2.1-4.3 3-4.3s2.5 1.5 3 4.3"/><path d="M9.8 8.4h4.4"/></svg>
          </span>
        </span>
        <span class="admin-hub-tile-title">Твинки</span>
        <span class="admin-hub-tile-desc">Связанные аккаунты с одного ПК и из облака</span>
      </a>
      {% endif %}
    </div>
  </section>
  {% endif %}

  {% if access_servers or access_mods %}
  <section class="admin-hub-section">
    <p class="admin-hub-kicker">Серверы</p>
    <div class="admin-hub-grid">
      {% if access_servers %}
      <a class="admin-hub-tile" href="index.php?p=admin&amp;c=servers">
        <span class="admin-hub-tile-head">
          <span class="admin-hub-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3.6" y="4" width="16.8" height="6.2" rx="1.4"/><rect x="3.6" y="13.8" width="16.8" height="6.2" rx="1.4"/><path d="M7.2 7.1h.02M7.2 16.9h.02"/></svg>
          </span>
          <span class="admin-hub-count">{{ total_servers }}</span>
        </span>
        <span class="admin-hub-tile-title">Серверы</span>
        <span class="admin-hub-tile-desc">Список, RCON, добавление</span>
      </a>
      {% endif %}
      {% if access_mods %}
      <a class="admin-hub-tile" href="index.php?p=admin&amp;c=mods">
        <span class="admin-hub-tile-head">
          <span class="admin-hub-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M8.2 4.6h4.4v4.2h4.6v4.4h-4.6v6.2H8.2v-6.2H3.8V8.8h4.4z"/></svg>
          </span>
        </span>
        <span class="admin-hub-tile-title">Моды</span>
        <span class="admin-hub-tile-desc">Игровые модификации</span>
      </a>
      {% endif %}
    </div>
  </section>
  {% endif %}

  {% if access_admins or access_groups or access_settings or access_vouchers or access_menu %}
  <section class="admin-hub-section">
    <p class="admin-hub-kicker">Команда и система</p>
    <div class="admin-hub-grid">
      {% if access_admins %}
      <a class="admin-hub-tile" href="index.php?p=admin&amp;c=admins">
        <span class="admin-hub-tile-head">
          <span class="admin-hub-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="2.6"/><path d="M4.4 18.2c.5-3 2.4-4.6 4.6-4.6s4.1 1.6 4.6 4.6"/><circle cx="16.4" cy="9" r="2.1"/><path d="M15.2 13.8c1.7 0 3.2 1.1 3.8 3.2"/></svg>
          </span>
          <span class="admin-hub-count">{{ total_admins }}</span>
        </span>
        <span class="admin-hub-tile-title">Админы</span>
        <span class="admin-hub-tile-desc">Состав, права, переопределения</span>
      </a>
      {% endif %}
      {% if access_vouchers %}
      <a class="admin-hub-tile" href="index.php?p=admin&amp;c=pay_card">
        <span class="admin-hub-tile-head">
          <span class="admin-hub-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4.4 8.2 8.2 4.4h7.6L19.6 8.2v7.6l-3.8 3.8H8.2L4.4 15.8z"/><circle cx="12" cy="12" r="2.2"/><path d="M12 6.6v1.4M12 16v1.4"/></svg>
          </span>
        </span>
        <span class="admin-hub-tile-title">Ваучеры</span>
        <span class="admin-hub-tile-desc">Выпуск ключей · активирует только гость (не залогиненный)</span>
      </a>
      {% endif %}
      {% if access_groups %}
      <a class="admin-hub-tile" href="index.php?p=admin&amp;c=groups">
        <span class="admin-hub-tile-head">
          <span class="admin-hub-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="8.2" cy="8.4" r="2.3"/><circle cx="15.8" cy="8.4" r="2.3"/><path d="M4.2 18.4c.5-2.6 2-4 4-4s3.5 1.4 4 4"/><path d="M11.8 18.4c.5-2.6 2-4 4-4s3.5 1.4 4 4"/></svg>
          </span>
        </span>
        <span class="admin-hub-tile-title">Группы</span>
        <span class="admin-hub-tile-desc">Веб- и серверные группы</span>
      </a>
      {% endif %}
      {% if access_settings %}
      <a class="admin-hub-tile" href="index.php?p=admin&amp;c=settings">
        <span class="admin-hub-tile-head">
          <span class="admin-hub-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3.05"/><path d="M12 3.7v2.1M12 18.2v2.1M3.7 12h2.1M18.2 12h2.1M6.2 6.2l1.5 1.5M16.3 16.3l1.5 1.5M17.8 6.2l-1.5 1.5M7.7 16.3l-1.5 1.5"/></svg>
          </span>
        </span>
        <span class="admin-hub-tile-title">Настройки</span>
        <span class="admin-hub-tile-desc">Вид сайта, опции, системный лог</span>
      </a>
      {% endif %}
      {% if access_menu %}
      <a class="admin-hub-tile" href="index.php?p=admin&amp;c=menu">
        <span class="admin-hub-tile-head">
          <span class="admin-hub-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M5 7h14M5 12h14M5 17h9.5"/></svg>
          </span>
        </span>
        <span class="admin-hub-tile-title">Меню</span>
        <span class="admin-hub-tile-desc">Пункты навигации сайта</span>
      </a>
      {% endif %}
    </div>
  </section>
  {% endif %}

  <section class="admin-hub-stats-wrap">
    <p class="admin-hub-kicker">Сводка</p>
    <div class="admin-hub-stats">
      <div class="admin-hub-stat">
        <div class="admin-hub-stat-label">Админы</div>
        <div class="admin-hub-stat-value">{{ total_admins }}</div>
      </div>
      <div class="admin-hub-stat">
        <div class="admin-hub-stat-label">Баны</div>
        <div class="admin-hub-stat-value">{{ total_bans }}</div>
      </div>
      <div class="admin-hub-stat">
        <div class="admin-hub-stat-label">Серверы</div>
        <div class="admin-hub-stat-value">{{ total_servers }}</div>
      </div>
      <div class="admin-hub-stat">
        <div class="admin-hub-stat-label">Блоки входа</div>
        <div class="admin-hub-stat-value">{{ total_blocks }}</div>
      </div>
      <div class="admin-hub-stat">
        <div class="admin-hub-stat-label">Протесты</div>
        <div class="admin-hub-stat-value">{{ total_protests }}</div>
        <div class="admin-hub-stat-hint" title="В архиве: {{ archived_protests }}">архив {{ archived_protests }}</div>
      </div>
      <div class="admin-hub-stat">
        <div class="admin-hub-stat-label">Заявки</div>
        <div class="admin-hub-stat-value">{{ total_submissions }}</div>
        <div class="admin-hub-stat-hint" title="В архиве: {{ archived_submissions }} · демо: {{ demosize }}">архив {{ archived_submissions }}</div>
      </div>
    </div>
  </section>
</div>
{% endblock %}
