{% extends 'layout.twig' %}
{% block extra_head %}
<link href="{{ asset_base }}themes/blue_v2/css/servers.css?v={{ css_ver }}" rel="stylesheet">
{% endblock %}
{% block topbar_title %}
<h1>Серверы</h1>
{% endblock %}
{% block content %}
<div id="dialog-placement" class="servers-dialog-sink"></div>
<div class="panel servers-panel">
  <header class="servers-head">
    <p class="servers-kicker">Статус</p>
    <h1 class="servers-title">Серверы</h1>
    <p class="servers-sub">{{ server_list|length }} шт. · нажми строку, чтобы открыть игроков и карту</p>
  </header>
  {% if access_bans %}
  <div class="hint servers-hint">
    У админа рядом с ником есть метка — открой меню: кик, бан, мут, сообщение.
  </div>
  {% endif %}
  <div class="servers-scroll">
    <div class="servers-list" role="table" aria-label="Список серверов">
      <div class="servers-list-head" role="row">
        <div class="servers-col servers-col-ico" role="columnheader">Игра</div>
        <div class="servers-col servers-col-ico" role="columnheader">ОС</div>
        <div class="servers-col servers-col-ico" role="columnheader">VAC</div>
        <div class="servers-col servers-col-host" role="columnheader">Сервер</div>
        <div class="servers-col servers-col-players" role="columnheader">Игроки</div>
        <div class="servers-col servers-col-map" role="columnheader">Карта</div>
        <div class="servers-col servers-col-chevron" role="columnheader" aria-hidden="true"></div>
      </div>
      {% if server_list %}
        {% for server in server_list %}
        <div class="servers-item" role="rowgroup">
          <div id="opener_{{ server.sid }}" class="servers-toggle servers-row" role="row" tabindex="0">
            <div class="servers-icons">
              <div class="servers-col servers-td-mod" role="cell">{{ server.icon_html|raw }}</div>
              <div class="servers-col servers-td-ico" role="cell" id="os_{{ server.sid }}"></div>
              <div class="servers-col servers-td-ico" role="cell" id="vac_{{ server.sid }}"></div>
            </div>
            <div class="servers-col servers-td-host" role="cell" id="host_{{ server.sid }}"><span class="servers-muted">Загрузка…</span></div>
            <div class="servers-col servers-td-players" role="cell" id="players_{{ server.sid }}"><span class="servers-muted">—</span></div>
            <div class="servers-col servers-td-map" role="cell" id="map_{{ server.sid }}"><span class="servers-muted">—</span></div>
            <div class="servers-col servers-td-chevron" role="cell" aria-hidden="true">
              <svg class="servers-chevron" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path fill="currentColor" d="M2.2 4.2L6 8l3.8-3.8-.9-.9L6 6.2 3.1 3.3z"/></svg>
            </div>
          </div>
          <div class="servers-detail-row" role="row">
            <div class="servers-detail-cell" role="cell">
              <div id="serverpanel_{{ server.sid }}" class="opener servers-detail">
                <div id="serverwindow_{{ server.sid }}" class="servers-window">
                  <div class="servers-detail-grid">
                    <div class="servers-players-col">
                      <div id="sinfo_{{ server.sid }}">
                        <table class="servers-players-table" width="100%" border="0" id="playerlist_{{ server.sid }}"></table>
                      </div>
                      <div id="noplayer_{{ server.sid }}" class="servers-empty">
                        <p class="servers-empty-text">Сейчас на сервере никого нет.</p>
                      </div>
                    </div>
                    <aside class="servers-aside">
                      <div class="servers-map-frame">
                        <img id="mapimg_{{ server.sid }}" src="images/maps/nomap.jpg" alt="Карта" loading="lazy" onerror="if(this.getAttribute('data-nomap'))return;this.setAttribute('data-nomap','1');this.src='images/maps/nomap.jpg';">
                      </div>
                      <div class="servers-addr">
                        <span class="servers-addr-label">Адрес</span>
                        <code>{{ server.ip }}:{{ server.port }}</code>
                      </div>
                      <div class="servers-actions">
                        <button type="button" class="btn btn-accent" onclick="document.location = 'steam://connect/{{ server.ip }}:{{ server.port }}'">Подключиться</button>
                        <button type="button" class="btn btn-outline-secondary" onclick="ShowBox('Обновление','Обновляем статус сервера…', 'blue', '', true, 1000);xajax_RefreshServer({{ server.sid }});">Обновить</button>
                      </div>
                    </aside>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        {% endfor %}
      {% else %}
        <div class="servers-empty-table" role="row">
          <div class="servers-empty-table-cell" role="cell">Нет включённых серверов.</div>
        </div>
      {% endif %}
    </div>
  </div>
</div>
{% endblock %}
