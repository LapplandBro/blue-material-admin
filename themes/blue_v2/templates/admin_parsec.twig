{% if permission_ok is defined and not permission_ok %}
<div class="form-flash form-flash--err">У вас нет доступа к просмотру связанных аккаунтов.</div>
{% else %}

<div class="parsec-panel">

<div class="form-page admin-form mb-3">
  <header class="form-page-head">
    <p class="form-page-kicker">Админка</p>
    <h2 class="form-page-title">Связанные аккаунты</h2>
    <p class="form-page-lead">Кто играет с того же ПК и кого связало облако антифрода</p>
  </header>
  <form method="get" action="index.php" class="form-grid" id="parsec-steam-form">
    <input type="hidden" name="p" value="admin">
    <input type="hidden" name="c" value="parsec">
    <div class="form-field form-field--full">
      <label class="form-label" for="steam">Игрок</label>
      <div class="input-group">
        <input type="text" class="form-control" id="steam" name="steam" value="{{ steam_input }}" placeholder="STEAM_0:X:Y · [U:1:…] · Community ID">
        <button type="submit" class="btn btn-accent">Найти твинки</button>
      </div>
    </div>
  </form>
  {% if not tables_ok %}
  <div class="parsec-note parsec-note-warn mt-3">База отпечатков ПК на сайте недоступна. Можно смотреть только связи из облака (если API включён).</div>
  {% endif %}
</div>

{% if flash_ok %}<div class="parsec-note parsec-note-ok mb-3">{{ flash_ok }}</div>{% endif %}
{% if flash_err %}<div class="parsec-note parsec-note-danger mb-3">{{ flash_err }}</div>{% endif %}
{% if error_msg %}<div class="parsec-note parsec-note-warn mb-3">{{ error_msg }}</div>{% endif %}

{% if can_write_eligible %}
<div class="form-page admin-form mb-3 parsec-write-card{% if write_mode %} parsec-write-armed{% endif %}">
  <header class="form-page-head">
    <h2 class="form-page-title">Опасная зона</h2>
    <p class="form-page-lead">Только владелец · {{ admin_steam }}</p>
  </header>
  <div class="parsec-note parsec-note-warn mb-3">
    Здесь можно только пометить группу аккаунтов как «забанена» или снять эту пометку.
    <strong>Код отпечатка ПК не меняйте</strong> — иначе у игрока останется старый файл, и при заходе его кикнет с ошибкой файла.
    Снятие пометки <strong>не разбанивает</strong> игрока в обычном списке банов.
  </div>
  {% if not session_unlocked %}
  <form method="post" action="{{ form_action }}" class="form-grid">
    <input type="hidden" name="csrf" value="{{ csrf }}">
    <input type="hidden" name="parsec_action" value="unlock">
    <div class="form-field form-field--full">
      <label class="form-label" for="panel_password">Пароль</label>
      <div class="input-group">
        <input type="password" class="form-control" id="panel_password" name="panel_password" autocomplete="off" placeholder="Пароль панели">
        <button type="submit" class="btn btn-outline-secondary">Разблокировать на 30 мин</button>
      </div>
    </div>
    {% if not password_configured %}
    <p class="parsec-muted">Сначала задайте пароль панели в настройках сайта (config.php).</p>
    {% endif %}
  </form>
  {% else %}
  <div class="parsec-write-bar">
    <form method="post" action="{{ form_action }}" class="parsec-write-toggle">
      <input type="hidden" name="csrf" value="{{ csrf }}">
      <input type="hidden" name="parsec_action" value="toggle_write">
      <label class="parsec-switch">
        <input type="checkbox" name="write_mode" value="1"{% if write_mode %} checked="checked"{% endif %} onchange="this.form.submit()">
        <span class="parsec-switch-ui"></span>
        <span class="parsec-switch-text">Разрешить правки {% if write_mode %}<em>включено</em>{% else %}<em class="parsec-muted">выключено</em>{% endif %}</span>
      </label>
    </form>
    <form method="post" action="{{ form_action }}">
      <input type="hidden" name="csrf" value="{{ csrf }}">
      <input type="hidden" name="parsec_action" value="lock">
      <button type="submit" class="btn btn-outline-secondary btn-sm">Закрыть правки</button>
    </form>
  </div>
  {% endif %}
</div>
{% endif %}

{% if authid and self_card %}
<div class="form-page admin-form mb-3">
  <header class="form-page-head">
    <h2 class="form-page-title">{% if self_card.name %}{{ self_card.name }}{% else %}Игрок без ника{% endif %}</h2>
    <p class="form-page-lead">{{ self_card.authid }}</p>
  </header>
  <div class="parsec-stats mb-3">
    <div class="parsec-stat">
      <div class="parsec-stat-label">В группе</div>
      <div class="parsec-stat-value">{{ self_card.family_size }}</div>
      <div class="parsec-stat-hint">аккаунтов</div>
    </div>
    <div class="parsec-stat">
      <div class="parsec-stat-label">Бан в списке</div>
      <div class="parsec-stat-value {% if self_card.active_ban %}parsec-text-danger{% else %}parsec-text-ok{% endif %}">
        {% if self_card.active_ban %}да{% else %}нет{% endif %}
      </div>
      <div class="parsec-stat-hint">на сайте</div>
    </div>
    <div class="parsec-stat">
      <div class="parsec-stat-label">Очки нарушений</div>
      <div class="parsec-stat-value">
        <div class="parsec-stat-bgm">
          <span><em>Бан</em><b>{{ self_card.points_ban }}</b></span>
          <span><em>Гаг</em><b>{{ self_card.points_gag }}</b></span>
          <span><em>Мут</em><b>{{ self_card.points_mute }}</b></span>
        </div>
      </div>
      <div class="parsec-stat-hint">текущие очки</div>
    </div>
    <div class="parsec-stat">
      <div class="parsec-stat-label">В облаке</div>
      {% if api_player %}
      <div class="parsec-stat-value">
        <span class="parsec-badge {{ api_player.state_class }}">{{ api_player.state_label }}</span>
      </div>
      <div class="parsec-stat-hint">твинков: {{ api_player.linked_count }}</div>
      {% else %}
      <div class="parsec-stat-value parsec-stat-value-sm parsec-muted">нет данных</div>
      <div class="parsec-stat-hint">нет ответа</div>
      {% endif %}
    </div>
  </div>

  <p class="parsec-links mb-3">
    <a href="{{ self_card.recid_url }}">История нарушений</a>
    <span class="parsec-sep">·</span>
    <a href="{{ self_card.banlist_url }}">Баны в списке</a>
  </p>

  {% if fp_meta and fp_meta.fingerprint %}
  <div class="parsec-block mb-3">
    <div class="parsec-block-title">Отпечаток ПК</div>
    <p class="parsec-muted">Это код компьютера игрока. Все аккаунты с одним кодом — одна группа (твинки с одного ПК).</p>
    <div class="parsec-fp" title="{{ fp_meta.fingerprint }}">{{ fp_meta.fingerprint_fmt }}</div>
    <div class="parsec-fp-raw">
      <span class="parsec-muted">Код целиком:</span>
      <code>{{ fp_meta.fingerprint }}</code>
    </div>
    <div class="parsec-fp-meta">
      {% if fp_meta.is_banned %}
      <span class="parsec-badge parsec-badge-danger">Группа: забанена</span>
      <span class="parsec-meta-item">Срок: <strong>{{ fp_meta.banned_duration_fmt }}</strong></span>
      {% if fp_meta.banned_at_fmt != '—' %}
      <span class="parsec-meta-item">С: <strong>{{ fp_meta.banned_at_fmt }}</strong></span>
      {% endif %}
      {% else %}
      <span class="parsec-badge parsec-badge-ok">Группа: не забанена</span>
      {% endif %}
    </div>
    {% if can_write and fp_meta.fingerprint %}
    <form method="post" action="{{ form_action }}" class="mt-3" onsubmit="return confirm('Подтвердите смену статуса группы. Обычный бан в списке банов при этом не меняется.');">
      <input type="hidden" name="csrf" value="{{ csrf }}">
      <input type="hidden" name="fingerprint" value="{{ fp_meta.fingerprint }}">
      {% if fp_meta.is_banned %}
      <input type="hidden" name="parsec_action" value="clear_ban">
      <button type="submit" class="btn btn-outline-secondary">Снять пометку «группа забанена»</button>
      {% else %}
      <input type="hidden" name="parsec_action" value="mark_ban">
      <button type="submit" class="btn btn-outline-secondary">Пометить группу: забанена (навсегда)</button>
      {% endif %}
    </form>
    {% endif %}
  </div>
  {% elseif tables_ok %}
  <div class="parsec-note parsec-note-muted mb-3">Для этого игрока отпечаток ПК ещё не записан — он появится после того, как игрок зайдёт на сервер с антифродом.</div>
  {% endif %}

  {% if api_player %}
  <div class="parsec-block">
    <div class="parsec-block-title">Облачный антифрод</div>
    <div class="parsec-api-grid">
      <div>
        <span class="parsec-muted">Статус</span>
        <div><span class="parsec-badge {{ api_player.state_class }}">{{ api_player.state_label }}</span></div>
      </div>
      <div>
        <span class="parsec-muted">Связанных аккаунтов</span>
        <div class="parsec-api-num">{{ api_player.linked_count }}</div>
      </div>
      {% if api_player.name %}
      <div>
        <span class="parsec-muted">Ник в облаке</span>
        <div>{{ api_player.name }}</div>
      </div>
      {% endif %}
      {% if api_player.ban_at_fmt %}
      <div>
        <span class="parsec-muted">Бан с</span>
        <div>{{ api_player.ban_at_fmt }}</div>
      </div>
      {% endif %}
      {% if api_player.unban_at_fmt %}
      <div>
        <span class="parsec-muted">До</span>
        <div>{{ api_player.unban_at_fmt }}</div>
      </div>
      {% endif %}
    </div>
    {% if api_player.ban_reason %}
    <div class="parsec-api-reason mt-2">{{ api_player.ban_reason }}</div>
    {% endif %}
  </div>
  {% endif %}
</div>

{% if linked_accounts|length > 0 %}
<div class="form-page admin-form mb-3">
  <header class="form-page-head">
    <h2 class="form-page-title">Твинки</h2>
    <p class="form-page-lead">{{ linked_accounts|length }} шт. · кроме текущего аккаунта</p>
  </header>
  <div class="table-responsive">
    <table class="table table-striped parsec-table">
      <thead>
        <tr>
          <th>Игрок</th>
          <th>SteamID</th>
          <th>Как связаны</th>
          <th class="text-end">Очки</th>
          <th>Бан</th>
          <th class="text-end">Действия</th>
        </tr>
      </thead>
      <tbody>
        {% for la in linked_accounts %}
        <tr>
          <td class="parsec-td-name">{% if la.name %}<strong>{{ la.name }}</strong>{% else %}<span class="parsec-muted">без ника</span>{% endif %}</td>
          <td class="parsec-td-steam"><code>{{ la.authid }}</code></td>
          <td>
            {% for chip in la.source_chips %}
            <span class="parsec-chip {{ chip.class }}">{{ chip.text }}</span>
            {% endfor %}
            {% if la.source_chips|length == 0 %}<span class="parsec-muted">—</span>{% endif %}
          </td>
          <td class="text-end parsec-td-points">{{ la.points_display }}</td>
          <td>{% if la.active_ban %}<span class="parsec-badge parsec-badge-danger">забанен</span>{% else %}<span class="parsec-muted">нет</span>{% endif %}</td>
          <td class="text-end parsec-td-actions">
            <span class="admin-actions">
              <a class="admin-action" href="{{ la.parsec_url }}">Твинки</a>
              <a class="admin-action" href="{{ la.view_url }}">Нарушения</a>
              <a class="admin-action" href="{{ la.banlist_url }}">Баны</a>
            </span>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% elseif authid %}
<div class="parsec-note parsec-note-muted mb-3">Других связанных аккаунтов не найдено — только этот SteamID.</div>
{% endif %}
{% endif %}

{% if tables_ok %}
<div class="form-page admin-form mb-3">
  <header class="form-page-head">
    <h2 class="form-page-title">Группы с пометкой «забанена»</h2>
    <p class="form-page-lead">всего {{ banned_total }}</p>
  </header>
  <div class="table-responsive">
    <table class="table table-striped parsec-table parsec-table-fp">
      <thead>
        <tr>
          <th>Отпечаток ПК</th>
          <th class="text-end">Аккаунтов</th>
          <th>Срок</th>
          <th>Когда</th>
          <th class="text-end"></th>
        </tr>
      </thead>
      <tbody>
        {% if banned_total == 0 %}
        <tr><td colspan="5" class="parsec-muted">Сейчас нет групп с пометкой «забанена».</td></tr>
        {% else %}
        {% for br in banned_rows %}
        <tr>
          <td class="parsec-td-fp">
            <div class="parsec-fp parsec-fp-compact" title="{{ br.fingerprint }}">{{ br.fingerprint_fmt }}</div>
            {% if br.steams_preview %}
            <div class="parsec-fp-steams parsec-muted">{{ br.steams_preview }}</div>
            {% endif %}
          </td>
          <td class="text-end">{{ br.steam_count }}</td>
          <td>{{ br.banned_duration_fmt }}</td>
          <td>{{ br.banned_at_fmt }}</td>
          <td class="text-end"><a class="btn btn-outline-secondary btn-sm" href="{{ br.open_url }}">Открыть</a></td>
        </tr>
        {% endfor %}
        {% endif %}
      </tbody>
    </table>
  </div>
  {% if banned_pages > 1 %}
  <div class="parsec-pager mt-2">
    {% for pl in page_links %}
    {% if pl.current %}<span class="parsec-pager-cur">{{ pl.n }}</span>{% else %}<a href="{{ pl.url }}">{{ pl.n }}</a>{% endif %}
    {% if not loop.last %}<span class="parsec-sep">·</span>{% endif %}
    {% endfor %}
  </div>
  {% endif %}
</div>
{% endif %}

</div>
{% endif %}
