{% if not permission_rcon %}
<div class="form-page">
  <p class="form-flash form-flash--err">Нет доступа к RCON.</p>
</div>
{% else %}
<div class="form-page admin-form rcon-panel">
  <header class="form-page-head">
    <p class="form-page-kicker">Админка</p>
    <h2 class="form-page-title">RCON</h2>
    <p class="form-page-lead">Команда + Enter · <code>clr</code> — очистить</p>
  </header>
  <div class="rcon-terminal" id="rcon">
    <div class="rcon-log" id="rcon_con">
      <div class="rcon-line rcon-line--sys">RCON-консоль готова. Введи команду ниже.</div>
    </div>
    <div class="rcon-input-bar">
      <span class="rcon-prompt" aria-hidden="true">›</span>
      <textarea id="cmd" rows="1" placeholder="status, sm plugins list…"></textarea>
      <button type="button" class="btn btn-accent" onclick="SendRcon();" id="rcon_btn" title="Отправить">Отправить</button>
    </div>
  </div>
</div>
<script>
(function () {
	var cmdEl = document.getElementById('cmd');
	if (!cmdEl) return;
	cmdEl.addEventListener('keydown', function (e) {
		if (e.key !== 'Enter' || e.shiftKey) return;
		e.preventDefault();
		if (this.disabled || this.value === 'Выполняю…') return;
		SendRcon();
	});
})();

function sbRconIdle(lock)
{
	var cmd = document.getElementById('cmd');
	var btn = document.getElementById('rcon_btn');
	lock = !!lock;
	if (cmd) {
		cmd.disabled = lock;
		if (!lock && cmd.value === 'Выполняю…')
			cmd.value = '';
	}
	if (!btn)
		return;
	btn.disabled = lock;
	if (lock) {
		if (btn.setAttribute)
			btn.setAttribute('data-sb-busy', '1');
	} else if (btn.removeAttribute) {
		btn.removeAttribute('data-sb-busy');
	}
}

function SendRcon()
{
	var cmd = document.getElementById('cmd');
	var btn = document.getElementById('rcon_btn');
	if (!cmd || cmd.disabled) return;
	if (cmd.value === 'Выполняю…') return;
	if (btn && ((btn.getAttribute && btn.getAttribute('data-sb-busy')) || btn.disabled)) return;
	var val = cmd.value;
	cmd.disabled = true;
	if (btn) {
		btn.disabled = true;
		if (btn.setAttribute)
			btn.setAttribute('data-sb-busy', '1');
	}
	cmd.value = 'Выполняю…';
	var sent = (typeof xajax_SendRcon === 'function') ? xajax_SendRcon('{{ id }}', val, true) : false;
	if (sent === false) {
		sbRconIdle(false);
		if (cmd)
			cmd.value = val;
	}
}

var scroll = {
	toBottom: function () {
		var el = document.getElementById('rcon_con');
		if (el) el.scrollTop = el.scrollHeight;
	}
};
</script>
{% endif %}
