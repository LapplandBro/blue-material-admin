<div class="admin-comments">
  <div class="admin-comments-label">Комментарии</div>
  {% if comments != "None" and comments != "Нет" and comments %}
    <ul class="admin-comments-list">
    {% for commenta in comments %}
      <li class="admin-comment{% if commenta.morecom %} is-more{% endif %}">
        <div class="admin-comment-meta">
          <strong>
            {% if commenta.comname %}
              {{ commenta.comname }}
            {% else %}
              <span class="admin-muted">админ удалён</span>
            {% endif %}
          </strong>
          <span>{{ commenta.added }}</span>
          {% if commenta.editcomlink != "" and commenta.editcomlink != "none" %}
            <span>{{ commenta.editcomlink|raw }} {{ commenta.delcomlink|raw }}</span>
          {% endif %}
        </div>
        <div class="admin-comment-text">{{ commenta.commenttxt|raw }}</div>
        {% if commenta.edittime %}
          <div class="admin-comment-edit">Изменено {{ commenta.edittime }} ({% if commenta.editname %}{{ commenta.editname }}{% else %}<span class="admin-muted">админ удалён</span>{% endif %})</div>
        {% endif %}
      </li>
    {% endfor %}
    </ul>
  {% else %}
    <p class="admin-muted">Комментариев нет</p>
  {% endif %}
</div>
