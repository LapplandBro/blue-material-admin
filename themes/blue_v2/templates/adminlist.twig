{% extends 'layout.twig' %}
{% block extra_head %}
<link href="{{ asset_base }}themes/blue_v2/css/adminlist.css" rel="stylesheet">
{% endblock %}
{% block topbar_title %}
<h1>Админы</h1>
{% endblock %}
{% block content %}
<div id="dialog-placement" class="adminlist-dialog-sink"></div>
<div class="adminlist-page">
  <header class="adminlist-page-head">
    <p class="adminlist-kicker">Команда</p>
    <h1 class="adminlist-title">Админы</h1>
    <p class="adminlist-sub">По серверам · нажми карточку, чтобы открыть состав</p>
  </header>

  {% for game in games %}
    {% if game.servers > 0 %}
    <section class="panel adminlist-game">
      <header class="adminlist-game-head">
        <span class="adminlist-game-ico">{{ game.icon_html|raw }}</span>
        <div class="adminlist-game-meta">
          <h2 class="adminlist-game-name">{{ game.name }}</h2>
          <p class="adminlist-game-count">
            {{ game.servers }}
            {% if game.servers == 1 %}сервер{% elseif game.servers < 5 %}сервера{% else %}серверов{% endif %}
          </p>
        </div>
      </header>

      <div class="adminlist-servers">
        {% for server in server_list %}
          {% if server.modid == game.mid and server.admincount > 0 %}
          <div class="adminlist-server">
            <div class="adminlist-toggle opener1" id="s_{{ server.sid }}" role="button" tabindex="0">
              <div class="adminlist-map">
                <img id="mapimg_{{ server.sid }}" src="images/maps/nomap.jpg" alt="" onerror="if(this.getAttribute('data-nomap'))return;this.setAttribute('data-nomap','1');this.src='images/maps/nomap.jpg';">
              </div>
              <div class="adminlist-server-meta">
                <div class="adminlist-server-name" id="host_{{ server.sid }}">
                  <span class="adminlist-host-fallback">{{ server.ip }}:{{ server.port }}</span>
                </div>
                <div class="adminlist-server-addr" id="sa{{ server.sid }}">{{ server.ip }}:{{ server.port }}</div>
              </div>
              <span class="adminlist-count">{{ server.admincount }} адм.</span>
              <svg class="adminlist-chevron" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path fill="currentColor" d="M2.2 4.2L6 8l3.8-3.8-.9-.9L6 6.2 3.1 3.3z"/></svg>
            </div>

            <div class="adminlist-xajax-sink" aria-hidden="true">
              <span id="os_{{ server.sid }}"></span>
              <span id="vac_{{ server.sid }}"></span>
              <span id="map_{{ server.sid }}"></span>
              <span id="players_{{ server.sid }}"></span>
              <div id="sinfo_{{ server.sid }}">
                <table id="playerlist_{{ server.sid }}"></table>
              </div>
              <div id="noplayer_{{ server.sid }}"></div>
              <div id="serverwindow_{{ server.sid }}"></div>
            </div>

            <div id="adminpanel_{{ server.sid }}" class="opener adminlist-body">
              <div class="adminlist-admins">
                {% for admin in server.adminlist %}
                {% set steam_url = admin.authid ? 'https://steamcommunity.com/profiles/' ~ admin.authid : '' %}
                <article class="adminlist-admin">
                  {% if steam_url %}
                  <a class="adminlist-avatar-link" href="{{ steam_url }}" target="_blank" rel="noopener noreferrer">
                    <img class="adminlist-avatar" src="{{ admin.avatar }}" alt="">
                  </a>
                  {% else %}
                  <span class="adminlist-avatar-link">
                    <img class="adminlist-avatar" src="{{ admin.avatar }}" alt="">
                  </span>
                  {% endif %}
                  <div class="adminlist-admin-main">
                    <div class="adminlist-admin-top">
                      {% if steam_url %}
                      <a class="adminlist-nick" href="{{ steam_url }}" target="_blank" rel="noopener noreferrer">{{ admin.user }}</a>
                      {% else %}
                      <span class="adminlist-nick">{{ admin.user }}</span>
                      {% endif %}
                      <span class="adminlist-imm" title="Иммунитет">имм. {{ admin.immunity|default(0) }}</span>
                    </div>
                    <div class="adminlist-admin-sub">
                      {% if admin.srv_group %}
                      <span class="adminlist-chip">{{ admin.srv_group }}</span>
                      {% else %}
                      <span class="adminlist-chip adminlist-chip-muted">свои права</span>
                      {% endif %}
                      {% if steam_url %}
                      <a class="adminlist-contact" href="{{ steam_url }}" target="_blank" rel="noopener noreferrer" title="Steam">
                        <svg width="12" height="12" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-10 9.3l5.4 2.2a2.7 2.7 0 0 1 3.8-1.9l4.2-3.1a3.2 3.2 0 1 1 1.2 1.5l-4.1 3a2.7 2.7 0 0 1-2.7 3.4 2.7 2.7 0 0 1-2.6-2l-3.8-1.5A10 10 0 1 0 12 2z"/></svg>
                        Steam
                      </a>
                      {% endif %}
                      {% if admin.vk %}
                      <a class="adminlist-contact" href="https://vk.com/{{ admin.vk }}" target="_blank" rel="noopener noreferrer" title="ВКонтакте">
                        <svg width="12" height="12" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M3 7.5h2.2c.1 3.3 1.5 5.3 3.4 6.3V7.5h2.1v4.2c1.9-.2 3.1-2.2 3.6-4.2h2.1c-.4 2.4-1.9 4.4-3.1 5.2 1.2.6 3 2.4 3.7 5.3h-2.3c-.5-1.9-1.8-3.4-3.5-3.6v3.6H8.6V14.6C6.6 15 4.7 16.7 4 20H1.7c.9-4 3.3-6.2 5.5-7.1C4.9 11.7 3.4 9.5 3 7.5z"/></svg>
                        VK
                      </a>
                      {% endif %}
                      {% if admin.discord %}
                      <span class="adminlist-contact" title="Discord">
                        <svg width="12" height="12" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M19.3 5.2A17.4 17.4 0 0 0 15 4l-.3.6a15.4 15.4 0 0 1 3.8 1.5 16 16 0 0 0-12.9 0A15 15 0 0 1 9.3 4L9 4a17.4 17.4 0 0 0-4.3 1.2C2.2 9.1 1.5 12.8 1.7 16.5A17.5 17.5 0 0 0 7 19l.7-1.1a11.4 11.4 0 0 1-1.8-.9l.4-.3a12.4 12.4 0 0 0 12.4 0l.4.3a11.4 11.4 0 0 1-1.8.9l.7 1.1a17.5 17.5 0 0 0 5.3-2.5c.3-4.1-.6-7.8-2.2-11.3zM8.7 14.3c-.8 0-1.5-.8-1.5-1.7s.7-1.8 1.5-1.8 1.5.8 1.5 1.8-.7 1.7-1.5 1.7zm6.6 0c-.8 0-1.5-.8-1.5-1.7s.7-1.8 1.5-1.8 1.5.8 1.5 1.8-.7 1.7-1.5 1.7z"/></svg>
                        {{ admin.discord }}
                      </span>
                      {% endif %}
                    </div>
                    {% if admin.comment %}
                    <p class="adminlist-about">{{ admin.comment }}</p>
                    {% endif %}
                  </div>
                </article>
                {% endfor %}
              </div>
            </div>
          </div>
          {% endif %}
        {% endfor %}
      </div>
    </section>
    {% endif %}
  {% else %}
  <div class="panel adminlist-empty">Пока нет админов, привязанных к серверам.</div>
  {% endfor %}
</div>
{% endblock %}
