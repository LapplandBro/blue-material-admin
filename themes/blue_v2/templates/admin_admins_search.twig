<div class="sea_open admin-search-toggle" role="button" tabindex="0">Поиск администраторов</div>
<div class="panel admin-search-body">
  <div class="table-responsive table-cards-wrap">
    <table class="admin-search-table form-search-table table-cards">
      <thead>
        <tr>
          <th class="form-search-pick"></th>
          <th class="form-search-crit">Критерий</th>
          <th>Ввод</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="form-search-pick" data-label=""><input id="name_" name="search_type" type="radio" value="name"></td>
          <td class="form-search-crit" data-label="Критерий"><label for="nick" onclick="$('name_').checked = true">Ник</label></td>
          <td data-label="Ввод"><input type="text" class="form-control" id="nick" value="" onmouseup="$('name_').checked = true" placeholder="Ник"></td>
        </tr>
        <tr>
          <td class="form-search-pick" data-label=""><input id="steam_" name="search_type" type="radio" value="radiobutton"></td>
          <td class="form-search-crit" data-label="Критерий"><label for="steamid" onclick="$('steam_').checked = true">SteamID</label></td>
          <td class="admin-search-split" data-label="Ввод">
            <input type="text" class="form-control" id="steamid" value="" onmouseup="$('steam_').checked = true" placeholder="SteamID">
            <select class="form-select" id="steam_match" onmouseup="$('steam_').checked = true">
              <option value="0" selected>Точное совпадение</option>
              <option value="1">Примерное совпадение</option>
            </select>
          </td>
        </tr>
        {% if can_editadmin %}
        <tr>
          <td class="form-search-pick" data-label=""><input id="admemail_" name="search_type" type="radio" value="radiobutton"></td>
          <td class="form-search-crit" data-label="Критерий"><label for="admemail" onclick="$('admemail_').checked = true">E-mail</label></td>
          <td data-label="Ввод"><input type="text" class="form-control" id="admemail" value="" onmouseup="$('admemail_').checked = true" placeholder="E-mail"></td>
        </tr>
        {% endif %}
        <tr>
          <td class="form-search-pick" data-label=""><input id="webgroup_" name="search_type" type="radio" value="radiobutton"></td>
          <td class="form-search-crit" data-label="Критерий"><label for="webgroup" onclick="$('webgroup_').checked = true">Группа ВЕБ разрешений</label></td>
          <td data-label="Ввод">
            <select class="form-select" id="webgroup" onmouseup="$('webgroup_').checked = true">
              {% for webgrp in webgroup_list|default([]) %}
              <option label="{{ webgrp.name }}" value="{{ webgrp.gid }}">{{ webgrp.name }}</option>
              {% endfor %}
            </select>
          </td>
        </tr>
        <tr>
          <td class="form-search-pick" data-label=""><input id="srvadmgroup_" name="search_type" type="radio" value="radiobutton"></td>
          <td class="form-search-crit" data-label="Критерий"><label for="srvadmgroup" onclick="$('srvadmgroup_').checked = true">Группа серверных разрешений</label></td>
          <td data-label="Ввод">
            <select class="form-select" id="srvadmgroup" onmouseup="$('srvadmgroup_').checked = true;" onblur="$('srvadmgroup_').checked = true;">
              {% for srvadmgrp in srvadmgroup_list|default([]) %}
              <option label="{{ srvadmgrp.name }}" value="{{ srvadmgrp.name }}">{{ srvadmgrp.name }}</option>
              {% endfor %}
            </select>
          </td>
        </tr>
        <tr>
          <td class="form-search-pick" data-label=""><input id="srvgroup_" name="search_type" type="radio" value="radiobutton"></td>
          <td class="form-search-crit" data-label="Критерий"><label for="srvgroup" onclick="$('srvgroup_').checked = true">Группа серверов</label></td>
          <td data-label="Ввод">
            <select class="form-select" id="srvgroup" onmouseup="$('srvgroup_').checked = true">
              {% for srvgrp in srvgroup_list|default([]) %}
              <option label="{{ srvgrp.name }}" value="{{ srvgrp.gid }}">{{ srvgrp.name }}</option>
              {% endfor %}
            </select>
          </td>
        </tr>
        <tr>
          <td class="form-search-pick" data-label=""><input id="admwebflags_" name="search_type" type="radio" value="radiobutton"></td>
          <td class="form-search-crit" data-label="Критерий"><label for="admwebflag" onclick="$('admwebflags_').checked = true">ВЕБ разрешения</label></td>
          <td data-label="Ввод">
            <select class="form-select" id="admwebflag" onmouseup="$('admwebflags_').checked = true" onblur="getMultiple(this, 1);" size="5" multiple>
              {% for admwebflag in admwebflag_list|default([]) %}
              <option label="{{ admwebflag.name }}" value="{{ admwebflag.flag }}">{{ admwebflag.name }}</option>
              {% endfor %}
            </select>
          </td>
        </tr>
        <tr>
          <td class="form-search-pick" data-label=""><input id="admsrvflags_" name="search_type" type="radio" value="radiobutton"></td>
          <td class="form-search-crit" data-label="Критерий"><label for="admsrvflag" onclick="$('admsrvflags_').checked = true">Серверные разрешения</label></td>
          <td data-label="Ввод">
            <select class="form-select" id="admsrvflag" name="admsrvflag" onmouseup="$('admsrvflags_').checked = true" onblur="getMultiple(this, 2);" size="5" multiple>
              {% for admsrvflag in admsrvflag_list|default([]) %}
              <option label="{{ admsrvflag.name }}" value="{{ admsrvflag.flag }}">{{ admsrvflag.name }}</option>
              {% endfor %}
            </select>
          </td>
        </tr>
        <tr>
          <td class="form-search-pick" data-label=""><input id="admin_on_" name="search_type" type="radio" value="radiobutton"></td>
          <td class="form-search-crit" data-label="Критерий"><label for="server" onclick="$('admin_on_').checked = true">Сервер</label></td>
          <td data-label="Ввод">
            <select class="form-select" id="server" onmouseup="$('admin_on_').checked = true">
              {% for server in server_list|default([]) %}
              <option value="{{ server.sid }}" id="ss{{ server.sid }}">Получение имени сервера… ({{ server.ip }}:{{ server.port }})</option>
              {% endfor %}
            </select>
          </td>
        </tr>
        <tr>
          <td colspan="3" class="admin-search-actions" data-label="">
            <button type="button" class="btn btn-accent btn-sm" id="searchbtn" onclick="search_admins('{{ exiperd_admins }}');">Поиск</button>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
{{ server_script|raw }}
<script>InitAccordion('div.sea_open', 'div.panel', 'content');</script>
