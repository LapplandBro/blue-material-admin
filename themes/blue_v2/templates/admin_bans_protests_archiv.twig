{% if not permission_protests %}
<div class="form-page">
  <p class="form-flash form-flash--err">Нет доступа к архиву протестов.</p>
</div>
{% else %}
<div id="protests-archiv" class="panel">
  <header class="form-page-head">
    <p class="form-page-kicker">Админка</p>
    <h2 class="form-page-title">Архив протестов</h2>
    <p class="form-page-lead">{{ protest_count_archiv }} · клик по строке — детали</p>
    <ul class="actions" id="banlist-nav">{{ aprotest_nav|raw }}</ul>
  </header>
  <div class="table-responsive table-cards-wrap">
    <table class="table table-v2 table-cards">
      <thead>
        <tr>
          <th>Ник</th>
          <th>SteamID / IP</th>
          <th class="text-end">Действия</th>
        </tr>
      </thead>
      <tbody>
      {% for protest in protest_list_archiv %}
        <tr id="apid_{{ protest.pid }}" class="opener5 banlist-row">
          <td class="toggler" data-label="Ник">
            {% if protest.archiv != 2 %}
              <a href="index.php?p=banlist{% if protest.authid != "" %}&amp;advSearch={{ protest.authid }}&amp;advType=steamid{% else %}&amp;advSearch={{ protest.ip }}&amp;advType=ip{% endif %}" title="Показать бан" onclick="event.cancelBubble=true;">{{ protest.name }}</a>
            {% else %}
              <span class="form-note">бан удалён</span>
            {% endif %}
          </td>
          <td data-label="SteamID / IP">{% if protest.authid != "" %}{{ protest.authid }}{% else %}{{ protest.ip }}{% endif %}</td>
          <td class="text-end" data-label="Действия">
            <span class="admin-actions">
              {% if permission_editban %}
              <a class="admin-action" href="#" onclick='event.cancelBubble=true; RemoveProtest("{{ protest.pid }}", {{ protest.label_js|raw }}, "2"); return false;'>Восстановить</a>
              <a class="admin-action admin-action--danger" href="#" onclick='event.cancelBubble=true; RemoveProtest("{{ protest.pid }}", {{ protest.label_js|raw }}, "0"); return false;'>Удалить</a>
              {% endif %}
              <a class="admin-action" href="index.php?p=admin&amp;c=bans&amp;o=email&amp;type=p&amp;id={{ protest.pid }}" onclick="event.cancelBubble=true;">Контакты</a>
            </span>
          </td>
        </tr>
        <tr id="apid_{{ protest.pid }}a" class="banlist-detail-row">
          <td colspan="3">
            <div class="opener5">
              <div class="admin-ticket">
                <div class="admin-detail-head">
                  <div>
                    <div class="admin-detail-title">Детали протеста</div>
                    <div class="form-note">В архиве: {{ protest.archive }}</div>
                  </div>
                  <div class="admin-detail-actions">{{ protest.protaddcomment|raw }}</div>
                </div>
                <div class="admin-facts admin-facts--ticket">
                  {% if protest.archiv != 2 %}
                  <div class="admin-fact">
                    <span class="admin-fact-label">Игрок</span>
                    <span class="admin-fact-value">{{ protest.name }}</span>
                  </div>
                  <div class="admin-fact">
                    <span class="admin-fact-label">SteamID</span>
                    <span class="admin-fact-value">{% if protest.authid == "" %}<span class="admin-muted">не указан</span>{% else %}{{ protest.authid }}{% endif %}</span>
                  </div>
                  <div class="admin-fact">
                    <span class="admin-fact-label">IP</span>
                    <span class="admin-fact-value">{% if protest.ip == 'none' or protest.ip == '' %}<span class="admin-muted">не указан</span>{% else %}{{ protest.ip }}{% endif %}</span>
                  </div>
                  <div class="admin-fact">
                    <span class="admin-fact-label">Бан добавлен</span>
                    <span class="admin-fact-value">{{ protest.date }}</span>
                  </div>
                  <div class="admin-fact">
                    <span class="admin-fact-label">Истекает</span>
                    <span class="admin-fact-value">{% if protest.ends == 'never' %}<span class="admin-muted">никогда</span>{% else %}{{ protest.ends }}{% endif %}</span>
                  </div>
                  <div class="admin-fact">
                    <span class="admin-fact-label">Админ</span>
                    <span class="admin-fact-value">{{ protest.admin }}</span>
                  </div>
                  <div class="admin-fact admin-fact--span">
                    <span class="admin-fact-label">Причина бана</span>
                    <span class="admin-fact-value">{{ protest.ban_reason|raw }}</span>
                  </div>
                  <div class="admin-fact">
                    <span class="admin-fact-label">Сервер</span>
                    <span class="admin-fact-value">{{ protest.server }}</span>
                  </div>
                  {% endif %}
                  <div class="admin-fact">
                    <span class="admin-fact-label">В архив отправил</span>
                    <span class="admin-fact-value">{% if protest.archivedby %}{{ protest.archivedby }}{% else %}<span class="admin-muted">админ удалён</span>{% endif %}</span>
                  </div>
                  <div class="admin-fact">
                    <span class="admin-fact-label">IP заявителя</span>
                    <span class="admin-fact-value">{{ protest.pip }}</span>
                  </div>
                  <div class="admin-fact">
                    <span class="admin-fact-label">Дата протеста</span>
                    <span class="admin-fact-value">{{ protest.datesubmitted }}</span>
                  </div>
                  <div class="admin-fact admin-fact--span">
                    <span class="admin-fact-label">Сообщение</span>
                    <span class="admin-fact-value">{{ protest.reason|raw }}</span>
                  </div>
                  {% include 'partials/admin_ticket_comments.twig' with { comments: protest.commentdata } %}
                </div>
              </div>
            </div>
          </td>
        </tr>
      {% else %}
        <tr>
          <td colspan="3" class="parsec-muted" data-label="">Протестов нет.</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</div>
<script>InitAccordion('tr.opener5', 'div.opener5', 'protests-archiv');</script>
{% endif %}
