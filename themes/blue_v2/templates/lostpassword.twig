{% extends 'layout.twig' %}
{% block extra_head %}
<link href="{{ asset_base }}themes/blue_v2/css/auth.css" rel="stylesheet">
{% endblock %}
{% block body %}
<div class="login-screen">
  <div class="panel login-card" id="lostpassword">
    <a class="brand login-brand" href="index.php?p=home">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" width="28" height="28" focusable="false">
          <path class="brand-mark-shield" d="M16 2.2l11 5v9.1c0 7.1-4.8 12.3-11 13.9C9.8 28.6 5 23.4 5 16.3v-9.1l11-5z"/>
          <path class="brand-mark-core" d="M16 8.1l6.1 2.6v5.1c0 4-2.6 7-6.1 8.1-3.5-1.1-6.1-4.1-6.1-8.1v-5.1L16 8.1z"/>
          <path class="brand-mark-flame" d="M16 13.1c1.5 1.3 2.4 2.5 2.4 3.9a2.4 2.4 0 1 1-4.8 0c0-1.4.9-2.6 2.4-3.9z"/>
        </svg>
      </span>
      <span class="brand-text">BLUE <span>ADMIN</span></span>
    </a>
    <p class="login-kicker">Панель администратора</p>
    {% if result_only %}
      <h1 class="login-title">{% if flash_type == 'success' %}Пароль сброшен{% else %}Восстановление пароля{% endif %}</h1>
      {% if flash_html %}
      <div class="alert {% if flash_type == 'success' %}alert-success{% else %}alert-danger{% endif %}" role="alert" id="{% if flash_type == 'success' %}msg-blue{% else %}msg-red{% endif %}">
        <div class="alert-heading">{{ flash_title }}</div>
        <div>{{ flash_html|raw }}</div>
      </div>
      {% endif %}
      <p class="login-lead login-links"><a href="{{ login_url }}">Вернуться ко входу</a></p>
    {% elseif lostpass_confirm %}
      <div id="login-content">
        <h1 class="login-title">Подтверждение сброса пароля</h1>
        <p class="login-lead">Нажмите кнопку ниже, чтобы сгенерировать новый пароль и получить его на почту. Простой переход по ссылке пароль не меняет.</p>
        <form method="post" action="{{ form_action }}" id="loginSubmit">
          {% if sb_csrf %}<input type="hidden" name="sb_csrf" value="{{ sb_csrf }}" />{% endif %}
          <input type="hidden" name="email" value="{{ lostpass_email }}" />
          <input type="hidden" name="validation" value="{{ lostpass_validation }}" />
          <input type="hidden" name="confirm_reset" value="1" />
          <div class="login-actions">
            <button type="submit" class="btn btn-accent" id="aconfirm" name="aconfirm" value="Подтвердить сброс пароля">Подтвердить сброс пароля</button>
          </div>
        </form>
      </div>
    {% else %}
      <div id="login-content">
        <h1 class="login-title">Восстановление пароля</h1>
        <p class="login-lead">Впишите e-mail учётной записи. Если он есть в системе, отправим ссылку для сброса.</p>
        <div class="alert alert-success" role="alert" id="msg-blue" style="display:none;">Если этот e-mail есть в системе, мы отправили письмо со ссылкой для сброса пароля. Проверьте также папку «Спам».</div>
        <div class="alert alert-danger" role="alert" id="msg-red" style="display:none;">Не удалось обработать запрос. Проверьте адрес и попробуйте позже.</div>
        <div class="field" id="loginPasswordDiv">
          <label class="form-label" for="email">E-Mail</label>
          <input type="text" tabindex="1" class="form-control" id="email" name="email" placeholder="mail@example.com" autocomplete="email">
        </div>
        <div class="login-actions" id="loginSubmit">
          <button type="button" class="btn btn-accent" id="alogin" name="alogin" value="Сбросить" onclick="xajax_LostPassword($('email').value);">Сбросить</button>
          <a class="btn btn-outline-secondary" href="{{ login_url }}">Ко входу</a>
        </div>
      </div>
    {% endif %}
  </div>
</div>
{% endblock %}
