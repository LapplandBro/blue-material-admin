<!DOCTYPE html>
<html lang="ru" data-bs-theme="dark" prefix="og: https://ogp.me/ns#">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title|default(seo_document_title|default('Blue Admin')) }}</title>
  {% if seo_description is defined and seo_description %}
  <meta name="description" content="{{ seo_description }}">
  {% endif %}
  {% if seo_noindex|default(false) %}
  <meta name="robots" content="noindex, nofollow">
  {% else %}
  <meta name="robots" content="index, follow">
  {% endif %}
  {% if seo_canonical is defined and seo_canonical %}
  <link rel="canonical" href="{{ seo_canonical }}">
  {% endif %}
  {% if og_title is defined and og_title %}
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ og_site_name|default(title) }}">
  <meta property="og:title" content="{{ og_title }}">
  <meta property="og:description" content="{{ og_description|default(seo_description|default('')) }}">
  <meta property="og:url" content="{{ seo_canonical|default(seo_site_url|default('')) }}">
  <meta property="og:locale" content="ru_RU">
  {% if og_image is defined and og_image %}
  <meta property="og:image" content="{{ og_image }}">
  <meta property="og:image:secure_url" content="{{ og_image }}">
  <meta property="og:image:type" content="{{ og_image_type|default('image/jpeg') }}">
  <meta property="og:image:width" content="{{ og_image_width|default(1200) }}">
  <meta property="og:image:height" content="{{ og_image_height|default(630) }}">
  <meta property="og:image:alt" content="{{ og_image_alt|default(og_title) }}">
  {% endif %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ og_title }}">
  <meta name="twitter:description" content="{{ og_description|default(seo_description|default('')) }}">
  {% if og_image is defined and og_image %}
  <meta name="twitter:image" content="{{ og_image }}">
  {% endif %}
  {% endif %}
  {% if seo_jsonld is defined and seo_jsonld %}
  <script type="application/ld+json">{{ seo_jsonld|raw }}</script>
  {% endif %}
  {% if asset_base %}<base href="{{ asset_base }}">{% endif %}
  <link rel="icon" href="{{ asset_base }}images/icons/logo-mark.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="{{ asset_base }}images/icons/logo-mark.svg">
  <link href="{{ asset_base }}themes/blue_v2/vendor/bootstrap/bootstrap.min.css" rel="stylesheet">
  <link href="{{ asset_base }}themes/blue_v2/vendor/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet">
  <link href="{{ asset_base }}themes/blue_v2/vendor/sweetalert/sweet-alert.css" rel="stylesheet">
  <link href="{{ asset_base }}themes/blue_v2/css/rubik.css" rel="stylesheet">
  <link href="{{ asset_base }}themes/blue_v2/css/blue.css?v={{ css_ver }}" rel="stylesheet">
  <script src="{{ asset_base }}scripts/mootools.js"></script>
  <script src="{{ asset_base }}scripts/sourcebans.js?v={{ sb_js_ver }}"></script>
  {{ xajax_js|raw }}
  <script>window.SB_CSRF={{ sb_csrf|default('')|json_encode|raw }};window.SB_SESSION={{ sb_session|default({})|json_encode|raw }};</script>
  {% block extra_head %}{% endblock %}
  <script>try{if(localStorage.getItem('sb-ui-sidebar')==='off')document.documentElement.classList.add('sidebar-off');}catch(e){}</script>
</head>
<body class="blue-v2">
<div class="page-loader" id="page-loader">
  <div class="preloader pls-blue">
    <svg class="pl-circular" viewBox="25 25 50 50" aria-hidden="true">
      <circle class="plc-path" cx="50" cy="50" r="20"></circle>
    </svg>
    <p>Загрузка</p>
  </div>
</div>
<div class="page-progress" id="page-progress" hidden></div>
{% block body %}
<header class="topbar">
  <div class="topbar-left">
    <a class="header-brand" href="index.php?p=home" title="На главную">
      {% include 'partials/brand_icon.twig' %}
      <span class="header-brand-text">
        <span class="header-brand-primary">{{ brand_primary|default('Blue Admin') }}</span>
        {% if brand_secondary %}
        <span class="header-brand-sep" aria-hidden="true">|</span>
        <span class="header-brand-secondary">{{ brand_secondary }}</span>
        {% endif %}
      </span>
    </a>
    <span class="topbar-split" aria-hidden="true"></span>
    <div class="topbar-crumb">
      <span class="topbar-kicker">Панель</span>
      <span class="topbar-sep" aria-hidden="true">/</span>
      <div class="topbar-title">{% block topbar_title %}{% endblock %}</div>
    </div>
  </div>
  <div class="topbar-actions">
    {% if logged_in %}
      <a class="topbar-btn" href="index.php?p=logout"><i class="bi bi-box-arrow-right" aria-hidden="true"></i> Выход</a>
    {% else %}
      <a class="topbar-btn topbar-btn-accent" href="{{ login_url }}">Вход</a>
    {% endif %}
    <button type="button" class="menu-trigger" id="menu-trigger" aria-label="Показать или скрыть меню" aria-controls="sidebar" aria-expanded="true">
      <span class="menu-trigger-lines" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>
  </div>
</header>
<div class="app-shell">
  <aside class="sidebar" id="sidebar" aria-label="Главное меню">
    <div class="profile-menu">
      <a href="{% if logged_in %}index.php?p=account{% else %}{{ login_url }}{% endif %}" title="{% if logged_in %}Профиль{% else %}Авторизация{% endif %}">
        <div class="profile-pic">
          <img src="{{ avatar|default('images/default-avatar.jpg') }}" alt="{% if logged_in %}{{ username }}{% else %}Гость{% endif %}" title="{% if logged_in %}{{ username }}{% else %}Гость{% endif %}" width="48" height="48" loading="lazy">
        </div>
        <div class="profile-info">
          {% if logged_in %}
          <span class="profile-info-label">Аккаунт</span> <mark>{{ username }}</mark>
          {% else %}
          Гость
          {% endif %}
        </div>
      </a>
    </div>

    <nav class="sidebar-nav">
      {% if nav_groups %}
      {% for group in nav_groups %}
      <div class="nav-group">
        <div class="nav-group-label">{{ group.label }}</div>
        <div class="nav-v2">
          {% for item in group.items %}
          <a class="nav-link{% if item.active %} active{% endif %}" href="{{ item.href }}"{% if item.active %} aria-current="page"{% endif %}{% if item.newtab %} target="_blank" rel="noopener noreferrer"{% endif %}{% if item.desc %} title="{{ item.desc }}"{% endif %}>
            {% if item.icon == 'sb-bi-vk' %}
            <i class="sb-bi-vk nav-ico" aria-hidden="true"></i>
            {% else %}
            <i class="bi {{ item.icon }} nav-ico" aria-hidden="true"></i>
            {% endif %}
            {{ item.title }}
          </a>
          {% endfor %}
        </div>
      </div>
      {% endfor %}
      {% else %}
      <div class="nav-group">
        <div class="nav-group-label">Обзор</div>
        <div class="nav-v2">
          <a class="nav-link{% if nav_active == 'home' or nav_active == '' %} active{% endif %}" href="index.php?p=home"{% if nav_active == 'home' or nav_active == '' %} aria-current="page"{% endif %}>
            <i class="bi bi-house-door nav-ico" aria-hidden="true"></i>
            Главная
          </a>
          <a class="nav-link{% if nav_active == 'servers' %} active{% endif %}" href="index.php?p=servers"{% if nav_active == 'servers' %} aria-current="page"{% endif %}>
            <i class="bi bi-hdd-stack nav-ico" aria-hidden="true"></i>
            Серверы
          </a>
        </div>
      </div>
      <div class="nav-group">
        <div class="nav-group-label">Списки</div>
        <div class="nav-v2">
          <a class="nav-link{% if nav_active == 'banlist' or nav_active == 'ui_v2' %} active{% endif %}" href="index.php?p=banlist"{% if nav_active == 'banlist' or nav_active == 'ui_v2' %} aria-current="page"{% endif %}>
            <i class="bi bi-shield-x nav-ico" aria-hidden="true"></i>
            Баны
          </a>
          <a class="nav-link{% if nav_active == 'commslist' %} active{% endif %}" href="index.php?p=commslist"{% if nav_active == 'commslist' %} aria-current="page"{% endif %}>
            <i class="bi bi-mic-mute nav-ico" aria-hidden="true"></i>
            Муты
          </a>
          <a class="nav-link{% if nav_active == 'adminlist' %} active{% endif %}" href="index.php?p=adminlist"{% if nav_active == 'adminlist' %} aria-current="page"{% endif %}>
            <i class="bi bi-people nav-ico" aria-hidden="true"></i>
            Админы
          </a>
        </div>
      </div>
      <div class="nav-group">
        <div class="nav-group-label">Кабинет</div>
        <div class="nav-v2">
          <a class="nav-link{% if nav_active == 'admin' %} active{% endif %}" href="index.php?p=admin"{% if nav_active == 'admin' %} aria-current="page"{% endif %}>
            <i class="bi bi-gear nav-ico" aria-hidden="true"></i>
            Админка
          </a>
          {% if logged_in %}
          <a class="nav-link{% if nav_active == 'account' %} active{% endif %}" href="index.php?p=account"{% if nav_active == 'account' %} aria-current="page"{% endif %}>
            <i class="bi bi-person nav-ico" aria-hidden="true"></i>
            Аккаунт
          </a>
          {% else %}
          <a class="nav-link{% if nav_active == 'login' %} active{% endif %}" href="{{ login_url }}"{% if nav_active == 'login' %} aria-current="page"{% endif %}>
            <i class="bi bi-box-arrow-in-right nav-ico" aria-hidden="true"></i>
            Вход
          </a>
          {% endif %}
        </div>
      </div>
      {% endif %}
    </nav>
  </aside>

  <div class="app-main">
    <div id="content" class="app-content">
      {% block content %}{% endblock %}
    </div>
    <footer class="app-footer">
      <div class="app-footer-inner">
        <div class="app-footer-copy">
          <strong>BLUE ADMIN</strong>{% if sb_version %} · {{ sb_version }}{% endif %}
          <p>Свободное ПО под <a href="https://www.gnu.org/licenses/gpl-3.0.html" target="_blank" rel="noopener noreferrer">GNU GPLv3</a>. Форк <a href="https://github.com/sbpp/sourcebans-pp" target="_blank" rel="noopener noreferrer">SourceBans++</a> / <a href="https://github.com/GameConnect/sourcebansv1" target="_blank" rel="noopener noreferrer">SourceBans</a>.</p>
          <p class="app-footer-author">Автор сборки: <a href="https://github.com/LapplandBro/blue-material-admin" target="_blank" rel="noopener noreferrer">LapplandBro</a></p>
          <p>Идея оформления: <a href="https://hlmod.net/threads/alpha-material-admin-refork-na-osnove-sb-1-5-4-7-bootstrap-3.36382/" target="_blank" rel="noopener noreferrer">Material Admin (HLMod)</a> · <a href="https://github.com/CrazyHackGUT" target="_blank" rel="noopener noreferrer">Kruzya</a>. Самостоятельный форк — живёт отдельно от остальных сборок.</p>
        </div>
        <nav class="app-footer-nav">
          <a href="index.php?p=home">Главная</a>
          <a href="index.php?p=servers">Серверы</a>
          <a href="index.php?p=banlist">Баны</a>
          <a href="index.php?p=commslist">Муты</a>
          <a href="index.php?p=adminlist">Админы</a>
        </nav>
      </div>
    </footer>
  </div>
</div>
{% endblock %}
<script src="{{ asset_base }}themes/blue_v2/vendor/bootstrap/bootstrap.bundle.min.js"></script>
<script src="{{ asset_base }}themes/blue_v2/vendor/sweetalert/sweet-alert.min.js"></script>
{{ extra_js|raw }}
{% block extra_js %}{% endblock %}
<script>
(function () {
  var loader = document.getElementById('page-loader');
  var bar = document.getElementById('page-progress');
  var hideTimer = 0;
  function showBar() {
    if (!bar) return;
    bar.removeAttribute('hidden');
    bar.className = 'page-progress is-on';
  }
  function hideBar() {
    if (!bar) return;
    bar.setAttribute('hidden', 'hidden');
    bar.className = 'page-progress';
  }
  function showLoader() {
    if (hideTimer) {
      window.clearTimeout(hideTimer);
      hideTimer = 0;
    }
    if (loader) {
      loader.hidden = false;
      loader.style.opacity = '1';
    }
    showBar();
  }
  function hideLoader() {
    hideBar();
    if (!loader) return;
    loader.style.transition = 'opacity .25s ease';
    loader.style.opacity = '0';
    hideTimer = window.setTimeout(function () {
      loader.hidden = true;
      loader.style.opacity = '';
    }, 280);
  }
  function isNavHref(href) {
    if (!href) return false;
    if (href.indexOf('#') === 0 || href.indexOf('javascript:') === 0) return false;
    if (href.indexOf('#^') !== -1) return false;
    return true;
  }
  document.addEventListener('click', function (e) {
    var a = e.target;
    while (a && a.tagName !== 'A') a = a.parentNode;
    if (!a || !a.href || a.target === '_blank') return;
    if ((a.className || '').indexOf('js-player-menu') !== -1) return;
    var href = a.getAttribute('href') || '';
    if (!isNavHref(href)) return;
    if ((a.getAttribute('onclick') || '').indexOf('SwapPane') !== -1) return;
    if (e.defaultPrevented || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    showLoader();
  }, true);
  document.addEventListener('submit', function () { showLoader(); }, true);
  window.addEventListener('pageshow', hideLoader);
  showLoader();
  if (document.readyState === 'complete')
    window.setTimeout(hideLoader, 400);
  else
    window.addEventListener('load', function () { window.setTimeout(hideLoader, 400); });
  window.setTimeout(hideLoader, 12000);

  var trigger = document.getElementById('menu-trigger');
  function sidebarOff() {
    return document.documentElement.classList.contains('sidebar-off');
  }
  function setSidebar(off) {
    document.documentElement.classList.toggle('sidebar-off', off);
    if (trigger) trigger.setAttribute('aria-expanded', off ? 'false' : 'true');
    try { localStorage.setItem('sb-ui-sidebar', off ? 'off' : 'on'); } catch (err) {}
  }
  if (trigger) {
    trigger.setAttribute('aria-expanded', sidebarOff() ? 'false' : 'true');
    trigger.addEventListener('click', function () { setSidebar(!sidebarOff()); });
  }
})();
</script>
<script>
(function () {
  var items = {{ page_notices|default([])|json_encode|raw }};
  if (!items || !items.length) return;
  var hosts = {};
  function hostFor(place) {
    place = place || 'top-right';
    if (hosts[place]) return hosts[place];
    var box = document.createElement('div');
    box.className = 'sb-toasts sb-toasts--' + place;
    box.setAttribute('aria-live', 'polite');
    document.body.appendChild(box);
    hosts[place] = box;
    return box;
  }
  function hide(el) {
    el.classList.remove('is-on');
    window.setTimeout(function () {
      if (el.parentNode) el.parentNode.removeChild(el);
    }, 280);
  }
  function show(item, wait) {
    window.setTimeout(function () {
      var el = document.createElement('div');
      el.className = 'sb-toast sb-toast--' + (item.tone || 'info');
      el.setAttribute('role', 'status');
      var msg = document.createElement('span');
      msg.className = 'sb-toast-msg';
      msg.appendChild(document.createTextNode(item.text || ''));
      var x = document.createElement('button');
      x.type = 'button';
      x.className = 'sb-toast-x';
      x.setAttribute('aria-label', 'Закрыть');
      x.appendChild(document.createTextNode('\u00d7'));
      x.addEventListener('click', function () { hide(el); });
      el.appendChild(msg);
      el.appendChild(x);
      hostFor(item.place).appendChild(el);
      window.setTimeout(function () { el.classList.add('is-on'); }, 20);
      window.setTimeout(function () { hide(el); }, item.ms || 4000);
    }, wait);
  }
  var i;
  for (i = 0; i < items.length; i++)
    show(items[i], i * 240);
})();
</script>
</body>
</html>
