<!DOCTYPE html>
<html lang="ru" class="page-booting" data-bs-theme="dark" data-page="{{ nav_active|default('home')|lower|replace({'_': '-'})|e('html_attr') }}"{% if nav_c|default('') %} data-sub="{{ nav_c|e('html_attr') }}"{% endif %} prefix="og: https://ogp.me/ns#">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script>
  (function () {
    var root = document.documentElement;
    var page = (root.getAttribute('data-page') || 'home').toLowerCase().replace(/[^a-z0-9-]/g, '');
    var sub = (root.getAttribute('data-sub') || '').toLowerCase().replace(/[^a-z0-9-]/g, '');
    var seed = page + (sub ? '/' + sub : '');
    var h = 2166136261;
    var i;
    for (i = 0; i < seed.length; i++) {
      h ^= seed.charCodeAt(i);
      h = Math.imul ? Math.imul(h, 16777619) : ((h * 16777619) | 0);
    }
    h = h >>> 0;
    function u(shift, min, span) {
      return min + ((h >>> shift) % (span + 1));
    }
    root.style.setProperty('--glow-1-x', u(0, 8, 36) + '%');
    root.style.setProperty('--glow-1-y', u(6, -10, 26) + '%');
    root.style.setProperty('--glow-2-x', u(12, 56, 38) + '%');
    root.style.setProperty('--glow-2-y', u(18, -4, 34) + '%');
    root.style.setProperty('--glow-3-x', u(24, 28, 52) + '%');
    root.style.setProperty('--glow-3-y', u(28, 58, 42) + '%');
  })();
  </script>
  <style>
    html.page-booting{background:#070d1a}
    html.page-booting #page-loader{display:block!important;opacity:1!important;visibility:visible}
    html.page-booting #page-loader[hidden]{display:block!important}
    html.page-booting #cookie-notice{display:none!important}
  </style>
  <noscript><style>html.page-booting #page-loader,html.page-booting #page-loader[hidden]{display:none!important}</style></noscript>
  <title>{{ title|default(seo_document_title|default('Blue Admin')) }}</title>
  {% if seo_description is defined and seo_description %}
  <meta name="description" content="{{ seo_description }}">
  {% endif %}
  {% if seo_noindex|default(false) %}
  <meta name="robots" content="noindex, nofollow">
  {% else %}
  <meta name="robots" content="index, follow">
  {% endif %}
  {% if seo_canonical is defined and seo_canonical %}
  <link rel="canonical" href="{{ seo_canonical }}">
  {% endif %}
  {% if og_title is defined and og_title %}
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ og_site_name|default(title) }}">
  <meta property="og:title" content="{{ og_title }}">
  <meta property="og:description" content="{{ og_description|default(seo_description|default('')) }}">
  <meta property="og:url" content="{{ seo_canonical|default(seo_site_url|default('')) }}">
  <meta property="og:locale" content="ru_RU">
  {% if og_image is defined and og_image %}
  <meta property="og:image" content="{{ og_image }}">
  <meta property="og:image:secure_url" content="{{ og_image }}">
  <meta property="og:image:type" content="{{ og_image_type|default('image/jpeg') }}">
  <meta property="og:image:width" content="{{ og_image_width|default(1200) }}">
  <meta property="og:image:height" content="{{ og_image_height|default(630) }}">
  <meta property="og:image:alt" content="{{ og_image_alt|default(og_title) }}">
  {% endif %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ og_title }}">
  <meta name="twitter:description" content="{{ og_description|default(seo_description|default('')) }}">
  {% if og_image is defined and og_image %}
  <meta name="twitter:image" content="{{ og_image }}">
  {% endif %}
  {% endif %}
  {% if seo_jsonld is defined and seo_jsonld %}
  <script type="application/ld+json">{{ seo_jsonld|raw }}</script>
  {% endif %}
  {% if asset_base %}<base href="{{ asset_base }}">{% endif %}
  <link rel="icon" href="{{ asset_base }}images/icons/logo-mark.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="{{ asset_base }}images/icons/logo-mark.svg">
  <link href="{{ asset_base }}themes/blue_v2/vendor/bootstrap/bootstrap.min.css" rel="stylesheet">
  <link href="{{ asset_base }}themes/blue_v2/vendor/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet">
  <link href="{{ asset_base }}themes/blue_v2/vendor/sweetalert/sweet-alert.css" rel="stylesheet">
  <link href="{{ asset_base }}themes/blue_v2/css/rubik.css" rel="stylesheet">
  <link href="{{ asset_base }}themes/blue_v2/css/blue.css?v={{ css_ver }}" rel="stylesheet">
  {% block extra_head %}{% endblock %}
  <link href="{{ asset_base }}themes/blue_v2/css/mobile.css?v={{ css_ver }}" rel="stylesheet">
  <link href="{{ asset_base }}themes/blue_v2/css/wide.css?v={{ css_ver }}" rel="stylesheet">
  <script>try{var _mq=window.matchMedia('(max-width: 991.98px)');var _k=_mq.matches?'sb-ui-sidebar-mobile':'sb-ui-sidebar-desktop';var _s=localStorage.getItem(_k);if(_mq.matches){if(_s!=='on')document.documentElement.classList.add('sidebar-off');}else{if(_s==='off')document.documentElement.classList.add('sidebar-off');else document.documentElement.classList.remove('sidebar-off');}}catch(e){}</script>
  <script src="{{ asset_base }}scripts/mootools.js"></script>
  <script src="{{ asset_base }}scripts/sourcebans.js?v={{ sb_js_ver }}"></script>
