<script>
(function () {
  var loader = document.getElementById('page-loader');
  var bar = document.getElementById('page-progress');
  var hideTimer = 0;
  var stuckTimer = 0;
  function reduceMotion() {
    return window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }
  function motionMs() {
    return reduceMotion() ? 0 : 340;
  }
  function showBar() {
    if (!bar) return;
    bar.removeAttribute('hidden');
    if (typeof window.requestAnimationFrame === 'function')
      window.requestAnimationFrame(function () { bar.classList.add('is-on'); });
    else
      bar.classList.add('is-on');
  }
  function hideBar() {
    if (!bar) return;
    bar.classList.remove('is-on');
    window.setTimeout(function () {
      if (!bar.classList.contains('is-on'))
        bar.setAttribute('hidden', 'hidden');
    }, motionMs());
  }
  function showLoader() {
    if (hideTimer) {
      window.clearTimeout(hideTimer);
      hideTimer = 0;
    }
    if (stuckTimer) {
      window.clearTimeout(stuckTimer);
      stuckTimer = 0;
    }
    if (loader) {
      loader.hidden = false;
      if (typeof window.requestAnimationFrame === 'function')
        window.requestAnimationFrame(function () { loader.classList.add('is-on'); });
      else
        loader.classList.add('is-on');
    }
    showBar();
    stuckTimer = window.setTimeout(function () {
      stuckTimer = 0;
      hideLoader();
    }, 2500);
  }
  function hideLoader() {
    if (stuckTimer) {
      window.clearTimeout(stuckTimer);
      stuckTimer = 0;
    }
    if (hideTimer) {
      window.clearTimeout(hideTimer);
      hideTimer = 0;
    }
    if (loader) {
      loader.hidden = false;
      loader.classList.add('is-on');
    }
    document.documentElement.classList.remove('page-booting');
    hideBar();
    if (!loader) return;
    if (typeof window.requestAnimationFrame === 'function')
      window.requestAnimationFrame(function () { loader.classList.remove('is-on'); });
    else
      loader.classList.remove('is-on');
    hideTimer = window.setTimeout(function () {
      if (!loader.classList.contains('is-on')) {
        loader.hidden = true;
        loader.style.opacity = '';
        loader.style.transition = '';
      }
      hideTimer = 0;
    }, motionMs());
  }
  function isNavHref(href) {
    if (!href) return false;
    if (href.indexOf('#') === 0 || href.indexOf('javascript:') === 0) return false;
    if (href.indexOf('#^') !== -1) return false;
    return true;
  }
  function isSamePathQuery(a) {
    try {
      var u = new URL(a.href, window.location.href);
      return u.origin === window.location.origin
        && u.pathname === window.location.pathname
        && u.search === window.location.search;
    } catch (err) {
      return false;
    }
  }
  function relHasExternal(a) {
    var rel = (a.getAttribute('rel') || '').toLowerCase().split(/\s+/);
    return rel.indexOf('external') !== -1;
  }
  function isAjaxForm(form) {
    var action = (form.getAttribute('action') || '').trim();
    if (!action || action === '#' || action.toLowerCase().indexOf('javascript:') === 0) return true;
    var onsubmit = form.getAttribute('onsubmit') || '';
    if (/return\s+false/i.test(onsubmit) || /xajax/i.test(onsubmit) || /DoLogin/i.test(onsubmit)) return true;
    return false;
  }
  function isFileHref(href, a) {
    if (a && a.hasAttribute('download')) return true;
    var path = href || '';
    try {
      path = new URL(a.href, window.location.href).pathname;
    } catch (err) {}
    path = String(path).toLowerCase().split('?')[0];
    if (/(^|\/)exportbans\.php$/.test(path) || /(^|\/)getdemo\.php$/.test(path)) return true;
    if (/\.(cfg|dem|zip|txt|csv|json|xml|sql|gz|7z|rar)$/.test(path)) return true;
    return false;
  }
  document.addEventListener('click', function (e) {
    var a = e.target;
    while (a && a.tagName !== 'A') a = a.parentNode;
    if (!a || !a.href || a.target === '_blank') return;
    if (a.hasAttribute('download') || relHasExternal(a) || isFileHref(a.getAttribute('href') || '', a)) return;
    if ((a.className || '').indexOf('js-player-menu') !== -1) return;
    var href = a.getAttribute('href') || '';
    if (!isNavHref(href) || isSamePathQuery(a)) return;
    if ((a.getAttribute('onclick') || '').indexOf('SwapPane') !== -1) return;
    if (e.defaultPrevented || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    showLoader();
  }, true);
  document.addEventListener('submit', function (e) {
    var form = e.target;
    if (!form || form.tagName !== 'FORM' || isAjaxForm(form)) return;
    showBar();
  }, true);
  function bootDone() {
    hideLoader();
  }
  if (document.readyState === 'complete')
    bootDone();
  else
    window.addEventListener('load', function () {
      if (typeof window.requestAnimationFrame === 'function')
        window.requestAnimationFrame(function () { bootDone(); });
      else
        bootDone();
    });
  window.addEventListener('pageshow', function (e) {
    if (e.persisted) bootDone();
  });
  window.addEventListener('pagehide', hideLoader);
  window.setTimeout(bootDone, 8000);

  var trigger = document.getElementById('menu-trigger');
  var backdrop = document.getElementById('sidebar-backdrop');
  var mqDrawer = window.matchMedia('(max-width: 991.98px)');
  var backdropHideTimer = 0;

  function sidebarOff() {
    return document.documentElement.classList.contains('sidebar-off');
  }

  function drawerMode() {
    return mqDrawer.matches;
  }

  function syncSidebarUi() {
    var off = sidebarOff();
    if (trigger) trigger.setAttribute('aria-expanded', off ? 'false' : 'true');
    if (backdrop) {
      if (backdropHideTimer) {
        window.clearTimeout(backdropHideTimer);
        backdropHideTimer = 0;
      }
      if (drawerMode() && !off) {
        backdrop.removeAttribute('hidden');
        backdrop.setAttribute('aria-hidden', 'false');
        document.body.classList.add('sidebar-drawer-open');
      } else {
        backdrop.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('sidebar-drawer-open');
        backdropHideTimer = window.setTimeout(function () {
          backdrop.setAttribute('hidden', 'hidden');
          backdropHideTimer = 0;
        }, 240);
      }
    }
  }

  function setSidebar(off) {
    document.documentElement.classList.toggle('sidebar-off', off);
    try {
      var key = drawerMode() ? 'sb-ui-sidebar-mobile' : 'sb-ui-sidebar-desktop';
      localStorage.setItem(key, off ? 'off' : 'on');
    } catch (err) {}
    syncSidebarUi();
  }

  function applySidebarForViewport() {
    try {
      var key = drawerMode() ? 'sb-ui-sidebar-mobile' : 'sb-ui-sidebar-desktop';
      var stored = localStorage.getItem(key);
      if (drawerMode()) {
        setSidebar(stored !== 'on');
      } else {
        setSidebar(stored === 'off');
      }
    } catch (err) {}
  }

  function tabbarVisibleSlots() {
    var slots = ['home', 'banlist', 'commslist', 'servers'];
    if (window.matchMedia('(min-width: 360px)').matches) {
      slots.push('account');
      slots.push('login');
    }
    if (window.matchMedia('(min-width: 576px)').matches) slots.push('adminlist');
    if (window.matchMedia('(min-width: 768px)').matches) slots.push('admin');
    return slots;
  }

  function syncTabbarSidebar() {
    var root = document.documentElement;
    var inDrawer = drawerMode();
    var hasMore = inDrawer;
    root.classList.toggle('tabbar-has-more', hasMore);
    if (!inDrawer) {
      document.querySelectorAll('.nav-link--in-tabbar').forEach(function (el) {
        el.classList.remove('nav-link--in-tabbar');
      });
      document.querySelectorAll('.nav-group--tabbar-empty').forEach(function (el) {
        el.classList.remove('nav-group--tabbar-empty');
      });
      return;
    }
    var visible = tabbarVisibleSlots();
    document.querySelectorAll('.sidebar-nav .nav-link[data-tab-slot]').forEach(function (el) {
      var slot = el.getAttribute('data-tab-slot');
      el.classList.toggle('nav-link--in-tabbar', visible.indexOf(slot) !== -1);
    });
    document.querySelectorAll('.sidebar-nav .nav-group').forEach(function (group) {
      var links = group.querySelectorAll('.nav-link:not(.nav-link--in-tabbar)');
      group.classList.toggle('nav-group--tabbar-empty', links.length === 0);
    });
  }

  if (trigger) {
    syncSidebarUi();
    trigger.addEventListener('click', function () { setSidebar(!sidebarOff()); });
  }
  syncTabbarSidebar();
  var tabMenu = document.getElementById('mobile-tabbar-menu');
  if (tabMenu) {
    tabMenu.addEventListener('click', function () { setSidebar(false); });
  }
  if (backdrop) {
    backdrop.addEventListener('click', function () { setSidebar(true); });
  }
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && drawerMode() && !sidebarOff()) setSidebar(true);
  });
  function onDrawerChange() {
    applySidebarForViewport();
    syncSidebarUi();
    syncTabbarSidebar();
  }
  if (mqDrawer.addEventListener) mqDrawer.addEventListener('change', onDrawerChange);
  else if (mqDrawer.addListener) mqDrawer.addListener(onDrawerChange);
  window.addEventListener('resize', function () {
    syncSidebarUi();
    syncTabbarSidebar();
  });
})();
</script>
<script>
(function () {
  var items = {{ page_notices|default([])|json_encode(15)|raw }};
  if (!items || !items.length) return;
  var hosts = {};
  function hostFor(place) {
    place = place || 'top-right';
    if (place === 'top-left' && !document.documentElement.classList.contains('sidebar-off')) {
      place = 'top-right';
    }
    if (hosts[place]) return hosts[place];
    var box = document.createElement('div');
    box.className = 'sb-toasts sb-toasts--' + place;
    box.setAttribute('aria-live', 'polite');
    document.body.appendChild(box);
    hosts[place] = box;
    return box;
  }
  function hide(el) {
    el.classList.remove('is-on');
    window.setTimeout(function () {
      if (el.parentNode) el.parentNode.removeChild(el);
    }, 340);
  }
  function show(item, wait) {
    window.setTimeout(function () {
      var el = document.createElement('div');
      el.className = 'sb-toast sb-toast--' + (item.tone || 'info');
      el.setAttribute('role', 'status');
      var msg = document.createElement('span');
      msg.className = 'sb-toast-msg';
      msg.appendChild(document.createTextNode(item.text || ''));
      var x = document.createElement('button');
      x.type = 'button';
      x.className = 'sb-toast-x';
      x.setAttribute('aria-label', 'Закрыть');
      x.appendChild(document.createTextNode('\u00d7'));
      x.addEventListener('click', function () { hide(el); });
      el.appendChild(msg);
      el.appendChild(x);
      hostFor(item.place).appendChild(el);
      window.setTimeout(function () { el.classList.add('is-on'); }, 20);
      window.setTimeout(function () { hide(el); }, item.ms || 8000);
    }, wait);
  }
  var i;
  for (i = 0; i < items.length; i++)
    show(items[i], i * 240);
})();
</script>
<script>
(function () {
  var btn = document.getElementById('page-top');
  if (!btn) return;
  var shown = false;
  var ticking = false;
  var showAt = 240;
  function pageOverflows() {
    var doc = document.documentElement;
    return (doc.scrollHeight - doc.clientHeight) > 48;
  }
  function sync() {
    ticking = false;
    var y = window.pageYOffset || document.documentElement.scrollTop || 0;
    var on = pageOverflows() && y > showAt;
    if (on === shown) return;
    shown = on;
    btn.classList.toggle('is-on', on);
    btn.setAttribute('aria-hidden', on ? 'false' : 'true');
    if (on) btn.removeAttribute('tabindex');
    else btn.setAttribute('tabindex', '-1');
  }
  function onScroll() {
    if (ticking) return;
    ticking = true;
    if (typeof window.requestAnimationFrame === 'function')
      window.requestAnimationFrame(sync);
    else
      sync();
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  if (typeof ResizeObserver === 'function') {
    try { new ResizeObserver(onScroll).observe(document.documentElement); }
    catch (e) {}
  }
  btn.addEventListener('click', function () {
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (typeof window.scrollTo === 'function')
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    else
      window.scrollTop = 0;
  });
  sync();
})();
</script>
<script>
(function () {
  var KEY = 'sb-cookie-ok';
  var el = document.getElementById('cookie-notice');
  var okBtn = document.getElementById('cookie-notice-ok');
  var hideTimer = 0;
  var dismissed = false;
  if (!el) return;
  function reduceMotion() {
    return window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }
  function storedOk() {
    try { return window.localStorage.getItem(KEY) === '1'; }
    catch (e) { return false; }
  }
  function syncShift() {
    var h = el.hidden ? 0 : el.offsetHeight;
    document.documentElement.style.setProperty('--cookie-notice-shift', h + 'px');
    document.documentElement.classList.toggle('cookie-notice-on', h > 0);
  }
  function reveal() {
    if (dismissed || storedOk()) return;
    el.hidden = false;
    syncShift();
    function on() {
      if (dismissed || storedOk()) return;
      el.classList.add('is-on');
    }
    if (reduceMotion()) {
      on();
      return;
    }
    if (typeof window.requestAnimationFrame === 'function')
      window.requestAnimationFrame(function () { window.requestAnimationFrame(on); });
    else
      window.setTimeout(on, 20);
  }
  function dismiss() {
    dismissed = true;
    try { window.localStorage.setItem(KEY, '1'); }
    catch (e) {}
    el.classList.remove('is-on');
    if (hideTimer) window.clearTimeout(hideTimer);
    hideTimer = window.setTimeout(function () {
      el.hidden = true;
      syncShift();
      hideTimer = 0;
    }, reduceMotion() ? 0 : 340);
  }
  if (okBtn) okBtn.addEventListener('click', dismiss);
  window.addEventListener('resize', syncShift, { passive: true });
  function afterBoot() {
    if (document.documentElement.classList.contains('page-booting')) {
      window.setTimeout(afterBoot, 80);
      return;
    }
    reveal();
  }
  if (document.readyState === 'complete')
    afterBoot();
  else
    window.addEventListener('load', afterBoot);
})();
</script>
<script>
(function () {
  var openWrap = null;
  function closeWrap(wrap) {
    if (!wrap) return;
    wrap.classList.remove('is-open');
    var btn = wrap.querySelector('.sb-select-btn');
    if (btn) btn.setAttribute('aria-expanded', 'false');
    if (openWrap === wrap) openWrap = null;
  }
  function closeAll(except) {
    var all = document.querySelectorAll('.sb-select.is-open');
    var i;
    for (i = 0; i < all.length; i++) {
      if (all[i] !== except) closeWrap(all[i]);
    }
  }
  function selectedLabel(sel) {
    var opt = sel.options[sel.selectedIndex];
    return opt ? (opt.textContent || '').replace(/\s+/g, ' ').trim() : '';
  }
  function fillMenu(wrap, sel) {
    var menu = wrap.querySelector('.sb-select-menu');
    if (!menu) return;
    menu.textContent = '';
    var nodes = sel.children;
    var i;
    for (i = 0; i < nodes.length; i++) {
      var node = nodes[i];
      if (node.tagName === 'OPTGROUP') {
        var g = document.createElement('li');
        g.className = 'sb-select-group';
        g.textContent = node.label || '';
        menu.appendChild(g);
        var j;
        for (j = 0; j < node.children.length; j++)
          menu.appendChild(itemFor(sel, node.children[j]));
      } else if (node.tagName === 'OPTION') {
        menu.appendChild(itemFor(sel, node));
      }
    }
    wrap._sbDirty = false;
  }
  function itemFor(sel, opt) {
    var li = document.createElement('li');
    var btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'sb-select-item';
    btn.textContent = (opt.textContent || '').replace(/\s+/g, ' ').trim();
    btn.disabled = !!opt.disabled;
    if (opt.selected) btn.classList.add('is-selected');
    btn.setAttribute('role', 'option');
    btn.setAttribute('data-value', opt.value);
    btn.addEventListener('click', function (e) {
      e.preventDefault();
      if (opt.disabled) return;
      var wrap = sel._sbWrap;
      sel.value = opt.value;
      syncBtn(wrap, sel);
      closeWrap(wrap);
      requestAnimationFrame(function () {
        sel.dispatchEvent(new Event('change', { bubbles: true }));
      });
    });
    li.appendChild(btn);
    return li;
  }
  function syncBtn(wrap, sel) {
    var btn = wrap.querySelector('.sb-select-btn');
    if (btn) {
      btn.textContent = selectedLabel(sel) || '\u00a0';
      btn.disabled = !!sel.disabled;
    }
    var items = wrap.querySelectorAll('.sb-select-item');
    var i;
    for (i = 0; i < items.length; i++) {
      items[i].classList.toggle('is-selected', items[i].getAttribute('data-value') === sel.value);
    }
  }
  function openWrapMenu(wrap, sel) {
    if (wrap._sbDirty) fillMenu(wrap, sel);
    syncBtn(wrap, sel);
    closeAll(wrap);
    wrap.classList.remove('sb-select--drop-up');
    wrap.classList.add('is-open');
    wrap.querySelector('.sb-select-btn').setAttribute('aria-expanded', 'true');
    openWrap = wrap;
    var menu = wrap.querySelector('.sb-select-menu');
    var rect = wrap.getBoundingClientRect();
    var mh = Math.min(menu.scrollHeight, window.innerHeight * 0.55);
    if (window.innerHeight - rect.bottom < mh + 12 && rect.top > mh)
      wrap.classList.add('sb-select--drop-up');
  }
  function enhance(sel) {
    if (!sel || sel.nodeType !== 1 || sel.tagName !== 'SELECT') return;
    if (sel._sbWrap) return;
    if (sel.multiple || (sel.size && sel.size > 1)) return;
    if (sel.closest && sel.closest('.tox, .sb-select')) return;
    if (!sel.classList.contains('form-select')) return;
    var wrap = document.createElement('div');
    wrap.className = 'sb-select';
    wrap._sbDirty = true;
    if (sel.classList.contains('banlist-bulk')) wrap.classList.add('banlist-bulk');
    if (sel.classList.contains('v2-page-select')) wrap.classList.add('v2-page-select');
    if (sel.classList.contains('form-select-sm')) wrap.classList.add('form-select-sm');
    sel.parentNode.insertBefore(wrap, sel);
    wrap.appendChild(sel);
    sel._sbWrap = wrap;
    var btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'sb-select-btn form-select' + (sel.classList.contains('form-select-sm') ? ' form-select-sm' : '') + (sel.classList.contains('banlist-bulk') ? ' banlist-bulk' : '') + (sel.classList.contains('v2-page-select') ? ' v2-page-select' : '');
    btn.setAttribute('aria-haspopup', 'listbox');
    btn.setAttribute('aria-expanded', 'false');
    var menu = document.createElement('ul');
    menu.className = 'sb-select-menu';
    menu.setAttribute('role', 'listbox');
    wrap.appendChild(btn);
    wrap.appendChild(menu);
    fillMenu(wrap, sel);
    syncBtn(wrap, sel);
    btn.addEventListener('click', function () {
      sel.dispatchEvent(new MouseEvent('mouseup', { bubbles: true }));
      if (wrap.classList.contains('is-open')) closeWrap(wrap);
      else openWrapMenu(wrap, sel);
    });
    btn.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        if (!wrap.classList.contains('is-open')) openWrapMenu(wrap, sel);
      }
      if (e.key === 'Escape') closeWrap(wrap);
    });
    sel.addEventListener('change', function () {
      syncBtn(wrap, sel);
    });
    if (typeof MutationObserver === 'function') {
      try {
        new MutationObserver(function () {
          wrap._sbDirty = true;
        }).observe(sel, { childList: true, subtree: true });
      } catch (err) {}
    }
  }
  function scan(root) {
    var list = (root || document).querySelectorAll('select.form-select');
    var i;
    for (i = 0; i < list.length; i++) enhance(list[i]);
  }
  function maybeEnhanceTree(n) {
    if (!n || n.nodeType !== 1) return;
    if (n.closest && n.closest('.sb-select, .tox')) return;
    if (n.matches && n.matches('select.form-select')) {
      enhance(n);
      return;
    }
    if (!n.querySelector) return;
    var found = n.querySelectorAll('select.form-select');
    var k;
    for (k = 0; k < found.length; k++) enhance(found[k]);
  }
  document.addEventListener('click', function (e) {
    if (openWrap && !openWrap.contains(e.target)) closeWrap(openWrap);
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && openWrap) closeWrap(openWrap);
  });
  if (document.readyState === 'loading')
    document.addEventListener('DOMContentLoaded', function () { scan(document); });
  else
    scan(document);
  if (typeof MutationObserver === 'function') {
    try {
      new MutationObserver(function (recs) {
        var r, j;
        for (r = 0; r < recs.length; r++) {
          for (j = 0; j < recs[r].addedNodes.length; j++)
            maybeEnhanceTree(recs[r].addedNodes[j]);
        }
      }).observe(document.documentElement, { childList: true, subtree: true });
    } catch (err) {}
  }
})();
</script>
