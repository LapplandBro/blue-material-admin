{% extends 'layout.twig' %}
{% block extra_head %}
<link href="{{ asset_base }}themes/blue_v2/css/forms.css?v={{ css_ver }}" rel="stylesheet">
<link href="{{ asset_base }}themes/blue_v2/css/admin_embed.css?v={{ css_ver }}" rel="stylesheet">
{% if nav_c == 'settings' %}
<link href="{{ asset_base }}themes/blue_v2/css/tinymce-blue.css" rel="stylesheet">
{% endif %}
{% endblock %}
{% block topbar_title %}{{ topbar_label|default('Админка') }}{% endblock %}
{% block content %}
<div class="admin-embed" id="cpanel">
  {% if breadcrumb %}
  <nav class="sb-v2-breadcrumb" aria-label="Навигация">
    <ol class="sb-v2-breadcrumb-list" id="breadcrumb">
      {% for crumb in breadcrumb %}
      <li{% if loop.last %} class="active"{% endif %}>
        {% if crumb.href and not loop.last %}
        <a href="{{ crumb.href }}">{{ crumb.label }}</a>
        {% else %}
        {{ crumb.label }}
        {% endif %}
      </li>
      {% endfor %}
    </ol>
  </nav>
  {% endif %}
  {% if admin_tabs %}
  <ul class="admin-embed-tabs" id="admin-page-menu">
    {% for tab in admin_tabs %}
    <li id="tab-{{ tab.id }}"{% if tab.active %} class="active"{% endif %}>
      {% if tab.external %}
      <a href="{{ tab.url }}" id="admin_tab_{{ tab.id }}">{{ tab.title }}</a>
      {% else %}
      <a href="index.php?p=admin&amp;c={{ nav_c|default('') }}#^{{ tab.id }}" id="admin_tab_{{ tab.id }}" onclick="SwapPane({{ tab.id }});return false;">{{ tab.title }}</a>
      {% endif %}
    </li>
    {% endfor %}
  </ul>
  {% endif %}
  <div class="admin-embed-body" id="admin-page-wrap">
    <div class="admin-embed-inner">
      {{ inner_html|raw }}
    </div>
  </div>
</div>
{% endblock %}
{% block extra_js %}
<script>if(typeof ProcessAdminTabs==="function"){ProcessAdminTabs();}</script>
{% if nav_c == 'settings' %}
<script src="{{ asset_base }}themes/blue_v2/vendor/tinymce/tinymce.min.js"></script>
<script>
(function () {
  if (typeof tinymce === 'undefined') return;
  var base = {{ asset_base|default('')|json_encode|raw }} + 'themes/blue_v2/vendor/tinymce';
  function initEditors() {
    var nodes = document.querySelectorAll('textarea.html-editor');
    if (!nodes.length) return;
    tinymce.remove('textarea.html-editor');
    tinymce.init({
      selector: 'textarea.html-editor',
      license_key: 'gpl',
      base_url: base,
      suffix: '.min',
      language: 'ru',
      language_url: base + '/langs/ru.js',
      skin: 'oxide-dark',
      content_css: ['dark', {{ (asset_base|default('') ~ 'themes/blue_v2/css/rubik.css')|json_encode|raw }}],
      plugins: 'lists link image table code autolink wordcount',
      menubar: false,
      branding: false,
      promotion: false,
      statusbar: true,
      toolbar_mode: 'wrap',
      toolbar: 'undo redo | blocks | bold italic underline strikethrough | forecolor backcolor | alignleft aligncenter alignright | bullist numlist | link image table | removeformat | code',
      convert_urls: false,
      relative_urls: false,
      remove_script_host: false,
      entity_encoding: 'raw',
      height: 480,
      content_style: 'body{background:#111c30;color:#c8d8f0;font-family:"Rubik","Segoe UI",system-ui,-apple-system,sans-serif;font-size:13px;line-height:1.55}body *:not(code):not(pre):not(kbd){font-family:"Rubik","Segoe UI",system-ui,-apple-system,sans-serif !important}a{color:#1e90ff}h1,h2,h3,h4{color:#e8f0ff;font-weight:700;line-height:1.3}h1{font-size:1.35em}h2{font-size:1.2em}h3{font-size:1.08em}p{margin:0 0 .7em}'
    });
  }
  document.addEventListener('submit', function () {
    if (window.tinymce) tinymce.triggerSave();
  }, true);
  if (document.readyState === 'loading')
    document.addEventListener('DOMContentLoaded', initEditors);
  else
    initEditors();
})();
</script>
{% endif %}
{% endblock %}
