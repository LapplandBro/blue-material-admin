<div class="panel">
  <header class="form-page-head">
    <p class="form-page-kicker">Админка</p>
    <h2 class="form-page-title">Админы сервера</h2>
    <p class="form-page-lead">{{ admin_count }} · клик по строке, если админ в игре</p>
  </header>
  <div class="table-responsive">
    <table class="table table-v2">
      <thead>
        <tr>
          <th>Имя админа</th>
          <th>SteamID админа</th>
        </tr>
      </thead>
      <tbody>
        {% for admin in admin_list|default([]) %}
        {% if admin.user %}
        <tr class="opener tbl_out" onmouseout="this.className='tbl_out'" onmouseover="this.className='tbl_hover'">
          <td{% if admin.ingame %} class="listtable_1_unbanned"{% endif %}>{{ admin.user }}</td>
          <td{% if admin.ingame %} class="listtable_1_unbanned"{% endif %}>{{ admin.authid }}</td>
        </tr>
        <tr>
          <td colspan="7">
            <div class="opener">
              {% if admin.ingame %}
              <div class="admin-detail-head">
                <div class="admin-detail-title">Детали администратора</div>
              </div>
              <table class="table table-v2">
                <thead>
                  <tr>
                    <th>Ник</th>
                    <th>Steam ID</th>
                    <th>IP</th>
                    <th>Время</th>
                    <th>Пинг</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>{{ admin.iname }}</td>
                    <td>{{ admin.authid }}</td>
                    <td>{{ admin.iip }}</td>
                    <td>{{ admin.itime }}</td>
                    <td>{{ admin.iping }}</td>
                  </tr>
                </tbody>
              </table>
              {% endif %}
            </div>
          </td>
        </tr>
        {% endif %}
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
<script>InitAccordion('tr.opener', 'div.opener', 'mainwrapper');</script>
