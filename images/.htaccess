# /images/ — только статика. Без index.html Apache с Options Indexes
# отдаёт листинг каталога (сканеры: «Directory Listing /images/»).
Options -Indexes

# На всякий случай: скрипты из images/ не исполнять.
<IfModule mod_authz_core.c>
	<FilesMatch "\.(php|php[0-9]?|phtml|pl|py|cgi|asp|aspx|sh|exe)$">
		Require all denied
	</FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
	<FilesMatch "\.(php|php[0-9]?|phtml|pl|py|cgi|asp|aspx|sh|exe)$">
		Order allow,deny
		Deny from all
	</FilesMatch>
</IfModule>
<IfModule mod_php7.c>
	php_flag engine off
</IfModule>
<IfModule mod_php5.c>
	php_flag engine off
</IfModule>
RemoveHandler .php .php3 .php4 .php5 .phtml
RemoveType .php .php3 .php4 .php5 .phtml
